/* Compile-time specific options */
component CiceroOptions {
	def sanityChecks = true;
	
	/* tiering/evaluation options */
	def enableIC: bool = false; // XXX always disabled

	/* compile-baked optimizations */
	def useLazyMethods: bool = true;
	def optimizeBytecode: bool = true;
	def useOptimizedGlobals: bool = true;
	def useExceptionTables: bool = false; // Wasm compilers need TRY/CATCH opcodes, not exnTable

	/* wasm backend */
	def compileFromTier1 = false; // true: bytecode-derived compile path; false: AST-direct
	def useRefcounting = true;    // reference-count WasmRuntime.objects handles
	def useShadowStack = true;   // true: WasmShadowStackCompiler - raw pointers + a Virgil shadow stack instead of WasmRuntime.objects indices. Requires compileFromTier1-style bytecode derivation (bytecode-only, no AST-direct equivalent).
	// true: fallible host calls return (value, raised) as a Wasm multi-value pair
	// instead of a bool plus a GET_RESULT fetch. Shadow-stack tier only. Set by
	// build.sh via -redef-field (TIER2=shadow-mv), which also requires a v3c whose
	// Wasm backend lowers multi-result returns.
	def useMultiValueReturn = false;

	/* tracing */
	def traceFunctionCalls = false;
	def traceBytecodeCompilation = false;
	def traceBytecodeEvaluation = false;
	def traceWasmCompilation = false;

	/* testing */
	def testBeyondRelooper = false;

	/* profiling */
	def profileStaticBytecode = false;
	def profileCompilationTimes = false;
	def profileStaticOpcodePairCounts = false;
	def profileDynamicBytecode = false;
	def profileDynamicOpcodePair = false;
	def profileJumpOutcomes = false;
	def profileInlineCaching = false;
	def profileFunctionCalls = false;
	def profileFuncObjectCalls = false;
	def profileCallerCalleePairs = false;
}

// for parsing
def opt = BasicOptions.new();
def ciceroOpt = OptionGroup.new("CICERO", opt);

/* Runtime options (set on the command line or implied by other options) */
component CLOptions {
	// cicero options
	def HELP = ciceroOpt.newBoolOption("help", false,
			"Print this help text.");
	def VERSION = ciceroOpt.newBoolOption("version", false,
			"Print the version of this interpreter and exit.");
	def TIER = ciceroOpt.newIntOption("tier", 1,
			"Set the evaluation tier for the interpreter (default: 1).");
	def CACHE = ciceroOpt.newBoolOption("cache", false,
			"Use inline caches for the tier1 interpreter.");
	def REPL = ciceroOpt.newBoolOption("repl", false,
			"Open the REPL after evaluating files.");
	def SUPPRESS_OUTPUT = ciceroOpt.newBoolOption("suppress-output", false,
			"Suppress the output of top-level evaluation (useful for benchmarking).");
	def CHECK_SYNTAX = ciceroOpt.newBoolOption("check-syntax", false,
			"Check syntax of a program only, then exit.");
	def FUZZING = ciceroOpt.newBoolOption("fuzzing", false,
			"Force program to return 0 in known failure conditions (e.g. parse error, unhandled exception). This is useful for fuzz testing, where nonzero exit codes denote some internal failure in the engine which should not happen.");
	def DO_NOT_EVALUATE = ciceroOpt.newBoolOption("do-not-evaluate", false,
			"Load program and compile it, but stop short of evaluating it.");
	def parse(args: Array<string>) -> Array<string> {
		return opt.parse(args);
	}
	def print() {
		def buf = StringBuilder.new();
		ciceroOpt.print(buf);
		System.puts(buf.extract());
	}
}

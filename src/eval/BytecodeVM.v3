class VirtualMachine {

    new() {}

	/* This is a handler stack which stores structure about exceptions:
	 *   (a, b, c)
	 *   where
	 *     a = absolute pc of handler
	 *     b = absolute size of stack (i.e. pop other things until you restore stack state)
	 *     c = absolute size of `callFrames` stack (i.e. pop other call frames until you restore the frame state)
	 */
	def handlers: ArrayStack<(int, int, int)> = ArrayStack.new();
	def stack: ArrayStack<Object> = ArrayStack.new();
    def callFrames: ArrayStack<CallFrame> = ArrayStack.new();

    var result: Result;
    var lastInstr: Maybe<Opcode> = Maybe.Nothing;

    def eval(bcode: Bytecode) -> Object {
        if (CiceroOptions.traceBytecodeEvaluation) {
            System.puts("Evaluating bytecode:\n");
            bcode.inspect();
            System.puts("==\n");
        }

        // Reset VM
        reset();

        /*
        * These local variables represent the currently active(executing) call frame
        * So, the `CallFrame` object in the call frames stack is out of sync.
        * So, it is kept in sync when a new call frame gets pushed (during CALL, CREATE_OBJECT)
        */
        var b = bcode;
        var code = b.instrs;
        var pc: int = 0;
        var localsStartIndex: int = 0;
        var nonLocalsStartIndex: int = 0;
        var baseStartIndex: int = 0;
        var loc: FileRange;
        var associatedFunc: FunctionProfileMetadata = TopLevel.metadata;

        // Setup top level frame and bytecode to execute
        callFrames.push(CallFrame.new(b, pc, localsStartIndex, nonLocalsStartIndex, baseStartIndex, associatedFunc));

        var dispatchStartTime : int = System.ticksUs(); 
        var opExecTime : int;
        while (pc < code.length || isExn()) {
            if (CiceroOptions.sanityChecks)
                if ((pc & 0b11) != 0) System.error("eval error", Strings.format1("unaligned pc access: %d", pc));

            // if frame is in an exceptional state, try to handle it!
            // Should this go after the handlers?
            if (isExn()) {
                def exn = getExn();
                if (handlers.empty()) {
                    // build full stack trace
                    callFrames.pop();
                    while (!callFrames.empty()){
                        def currentCallFrame = callFrames.pop();
                        exn.stacktrace.put((currentCallFrame.associatedFunc.label, currentCallFrame.loc));
                    }
		            result = Result.Exn(exn);
                    if (CiceroOptions.traceBytecodeEvaluation) System.puts("returned with exception\n");
                    return null;
                } else {
                    var isTopFrame = true; // Flag to prevent duplicating the stacktrace for the current frame that threw the exception 
                    def p = handlers.pop();
                    // build stack trace until the handlers call frame
                    while (callFrames.top > p.2){
                        def currentCallFrame = callFrames.pop();
                        if (!isTopFrame) exn.stacktrace.put((currentCallFrame.associatedFunc.label, currentCallFrame.loc));
                        isTopFrame = false;
                    }

                    def currentCallFrame = callFrames.peek();
                    // If we actually popped frames to get here, log the handler's frame as well.
                    // If isOriginalFrame is still true, the exception was caught locally, so we skip it.
                    if (!isTopFrame) exn.stacktrace.put((currentCallFrame.associatedFunc.label, currentCallFrame.loc));

                    stack.resize(p.1); // equivalent to `while (stack.top != p.1) stack.pop();`
                    // push error value
                    stack.push(exn);

                    // Restore VM context to the handler
                    pc = p.0;
                    b = currentCallFrame.b;
                    code = b.instrs;
                    localsStartIndex = currentCallFrame.localsStartIndex; 
                    nonLocalsStartIndex = currentCallFrame.nonLocalsStartIndex;
                    baseStartIndex = currentCallFrame.baseStartIndex;
                    associatedFunc = currentCallFrame.associatedFunc;

		            result = Result.Uncomputed;
                }
            }

            // Fetch
            def bytecode = Ref<Instruction>.at(code, pc);
            loc = b.sourceMap[pc >> 2];

            /* Inline caches */
            var cache: CacheState;

            def opcode = bytecode.opcode;
            def opcode_pc = pc;
            def operand  = bytecode.operand;

            if (CiceroOptions.traceBytecodeEvaluation) {
                System.puts(Strings.format3("  +%d: %s %d\n", pc, opcode.name, bytecode.operand));
                System.puts("    stack:\n");
                for (i < stack.top) {
                    System.puts("    ");
                    def element = stack.elems[i];
                    if (element == null) System.puts("NULL");
                    else System.puts(element.display());
                    System.ln();
                }
                System.puts("    exn loc stack:\n");
                for (i < handlers.top) {
                    System.puts("    ");
                    // SUPREME: TODO ( show handler call Frame stack as well)
                    System.puts(Strings.format2("=> %d (%d)", handlers.elems[i].0, handlers.elems[i].1));
                    System.ln();
                }
                System.puts("--\n");
            }


            pc += 4;
            match (opcode) {
                NOP => {
                    if (CiceroOptions.profileDynamicBytecode) {
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, 0); // NOP has 0 zero execution time
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_CONST => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    stack.push(b.constPool[operand]);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_GLOBAL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def id = b.stringPool[operand];
                    match (Globals.loadGlobal(id)){
                        // `v` is a tuple -> (Object, int)
                        Just(v) => {
                            stack.push(v.0);

                            if (CiceroOptions.useOptimizedGlobals) {
                                // perform bytecode rewriting to replace `LOAD_GLOBAL` with `LOAD_GLOBAL_BY_INDEX`
                                // `v.1` gives us the index into the `Globals.values` vector
                                def global_index = v.1;
                                // arguments: bytecode array, opcode index to replace, new opcode, index into `Global.values` vector
                                rewriteBytecode(code, pc - 4, Opcode.LOAD_GLOBAL_BY_INDEX, global_index);
                            }
                        }
                        Nothing => throw(Exceptions.unboundGlobal(id), associatedFunc.label, loc);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_GLOBAL_BY_INDEX => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def value = Globals.loadGlobalByIndex(operand);
                    stack.push(value);
                    
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_LOCAL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def local = stack.elems[localsStartIndex + operand];
                    if (local == null)
                        throw(Exceptions.unboundLocal(b.locals[operand]), associatedFunc.label, loc);
                    else
                        stack.push(local);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_LOCAL_SAFE => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    stack.push(stack.elems[localsStartIndex + operand]);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_NONLOCAL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def nonlocal = stack.elems[nonLocalsStartIndex + operand];

                    if (CiceroOptions.sanityChecks) {
                        if (nonlocal == null) {
                            System.error("eval error", "nonlocal null");
                        }
                    }
                    stack.push(nonlocal);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                STORE_GLOBAL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def id = b.stringPool[operand];
                    def top = stack.pop();
                    // index into the `Globals.values` vector
                    def global_index = Globals.storeGlobal(id, top);

                    if (CiceroOptions.useOptimizedGlobals) {
                        // perform bytecode rewriting to replace `STORE_GLOBAL` with `STORE_GLOBAL_BY_INDEX`
                        // arguments: bytecode array, opcode index to replace, new opcode, index into `Global.values` vector
                        rewriteBytecode(code, pc - 4, Opcode.STORE_GLOBAL_BY_INDEX, global_index);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                STORE_GLOBAL_BY_INDEX => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.pop();
                    Globals.storeGlobalByIndex(operand, top);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                STORE_LOCAL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    stack.elems[localsStartIndex + operand] = stack.pop();

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                JUMP => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    pc += i24.view(operand);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                JUMP_IF_FALSE => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.pop();
                    if (!top.isTrue()) pc += i24.view(operand);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                JUMP_IF_TRUE_PEEK => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.peek();
                    if (!top.isTrue()) {
                        stack.pop();
                    } else {
                        pc += i24.view(operand);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                JUMP_IF_FALSE_PEEK => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.peek();
                    if (top.isTrue()) {
                        stack.pop();
                    } else {
                        pc += i24.view(operand);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                RAISE => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.pop();
                    assertType(ClassObjects.classStr, top, associatedFunc.label, loc);
                    if (isExn()) {
                        if (CiceroOptions.profileDynamicBytecode) {
                            opExecTime = System.ticksUs() - opExecTime;
                            ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                        }
                        if (CiceroOptions.profileDynamicOpcodePair){
                            dispatchStartTime = System.ticksUs();
                        }
                        continue;
                    }

                    throw(StrObject.!(top).str, associatedFunc.label, loc);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                ASSERT_FUNC => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.peek();
                    assertType(ClassObjects.classFunc, top, associatedFunc.label, loc);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                CALL => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def fvBaseStartIndex = stack.top - operand - 1;
                    def fv = FuncObject.!(stack.elems[fvBaseStartIndex]); // this cast succeeds because of ASSERT_FUNC
                    def params = fv.params;

                    // arity check
                    assertArity(params.length, operand, associatedFunc.label, loc);
                    if (isExn()) {
                        if (CiceroOptions.profileDynamicBytecode) {
                            opExecTime = System.ticksUs() - opExecTime;
                            ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                        }
                        if (CiceroOptions.profileDynamicOpcodePair){
                            dispatchStartTime = System.ticksUs();
                        }
                        continue;
                    }

                    match (fv.code.code){
                        Bytecode => {
                            // update the ip in the caller frame!
                            saveFrame(pc, loc);

                            // Update all the local variables to represent the new executing callee frame
			                def bytecode = Code.Bytecode.!(fv.code.code).bytecode;
                            b = bytecode;
                            code = b.instrs;
                            pc = 0;
                            baseStartIndex = fvBaseStartIndex;
                            localsStartIndex = fvBaseStartIndex + 1;
                            nonLocalsStartIndex = localsStartIndex + bytecode.locals.length;
                            associatedFunc = fv.metadata;
                            loc = b.sourceMap[0];
                            
                            // grow stack (if needed for remaining local variables)
                            stack.resize(nonLocalsStartIndex);

                            if (fv.instanceOf(ClassObjects.classMethod)) {
                                stack.elems[baseStartIndex] = MethodObject.!(fv).obj;
                                localsStartIndex--;
                            }
                            // push nonlocals on the stack
                            for (i < bytecode.nonlocals.length) {
                                def id : string = bytecode.nonlocals[i];
                                // search for id in nonlocal args
                                var found: bool;
                                for (p in fv.nonlocals) {
                                    if (Strings.equal(id, p.0)) {
                                        stack.push(p.1);
                                        found = true;
                                        break;
                                    }
                                }
                                if (!found) {
                                    // might this ever happen?
                                    System.error("eval error", "unable to unify nonlocal arguments");
                                }
                            }

                            // push the new frame
                            callFrames.push(CallFrame.new(b, pc, localsStartIndex, nonLocalsStartIndex, fvBaseStartIndex, associatedFunc));
                        }
                        _ => {

                            var args: Vector<Object> = Vector.new();
                            for (i < operand) {
                                args.put(stack.pop());
                            }
                            args.reverse(); // XXX reverse can be expensive, should do arithmetic on index instead

                            stack.pop(); // pop `funcObject`

                            // evaluate argument values
                            var argv: Array<(string, Object)>;

                            if (fv.instanceOf(ClassObjects.classMethod)) {
                                argv = Array.new(args.length + 1);
                                for (i < args.length) {
                                    def arg = args[i];
                                    if (i < params.length) // avoid out of bounds but don't raise exception
                                        argv[i + 1] = (params[i], arg);
                                }
                                argv[0] = ("self", MethodObject.!(fv).obj);
                            } else {
                                argv = Array.new(args.length);
                                for (i < args.length) {
                                    def arg = args[i];
                                    if (i < params.length) // avoid out of bounds but don't raise exception
                                        argv[i] = (params[i], arg);
                                }
                            }

                            // create new frame
                            // SUPREME: TODO: SETUP CORRECT FRAME OBJECT
                            def frame = FrameObjects.newFrame(null, fv.id, fv.code, argv, fv.nonlocals);

                            var startTime: int;

                            if (CiceroOptions.profileFunctionCalls || CiceroOptions.profileFuncObjectCalls || CiceroOptions.profileCallerCalleePairs) {
                                startTime = System.ticksUs();
                            }

                            if (CiceroOptions.profileDynamicBytecode) {
                                opExecTime = System.ticksUs() - opExecTime;
                                ProfileBytecode.profileDynamicExecutionTime(opcode.tag, opExecTime);
                            }

                            // evaluate the frame (execute the function)
                            frame.eval();
                            
                            if (CiceroOptions.profileDynamicBytecode) {
                                opExecTime = System.ticksUs();
                            }

                            if (CiceroOptions.profileFunctionCalls || CiceroOptions.profileFuncObjectCalls || CiceroOptions.profileCallerCalleePairs) {
                                def inclusiveExecutionTime: int = System.ticksUs() - startTime; // in microseconds
                                if (CiceroOptions.profileFunctionCalls) {
                                    ProfileFunctionCalls.profileFunctionCall(fv.metadata, inclusiveExecutionTime, inclusiveExecutionTime);
                                }
                                if (CiceroOptions.profileFuncObjectCalls) {
                                    ProfileFunctionCalls.profileFunctionObjectCall(fv.uid, fv.metadata.label, inclusiveExecutionTime, inclusiveExecutionTime);
                                }
                                if (CiceroOptions.profileCallerCalleePairs) {
                                    ProfileCallerCalleePairs.profilePair(associatedFunc, fv.metadata, inclusiveExecutionTime);
                                }
                            }

                            if (frame.isExn()) {
                                rethrow(frame.getExn(), associatedFunc.label, loc);

                                if (CiceroOptions.profileDynamicBytecode) {
                                    opExecTime = System.ticksUs() - opExecTime;
                                    ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                                }
                                if (CiceroOptions.profileDynamicOpcodePair){
                                    dispatchStartTime = System.ticksUs();
                                }
                                continue;
                            }
                            stack.push(frame.getValue());

                        }
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                TRY => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    handlers.push((pc + operand, stack.top, callFrames.top));

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                CATCH => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    handlers.pop();

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                // stack manipulation
                POP => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    for (i < operand) stack.pop();

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                DUPE => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    // special path, operand = 0
                    stack.push(stack.elems[stack.top - operand - 1]);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                SWAP => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.peek();
                    def val = stack.elems[stack.top - operand - 1];
                    stack.elems[stack.top - 1] = val;
                    stack.elems[stack.top - operand - 1] = top;

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                // objects
                CREATE_CLASS => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def superclass = stack.pop();
                    assertType(ClassObjects.classClass, superclass, associatedFunc.label, loc);
                    if (isExn()) {
                        if (CiceroOptions.profileDynamicBytecode) {
                            opExecTime = System.ticksUs() - opExecTime;
                            ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                        }
                        if (CiceroOptions.profileDynamicOpcodePair){
                            dispatchStartTime = System.ticksUs();
                        }
                        continue;
                    }

                    def classhole = b.classPool[operand];
                    stack.push(classhole(ClassObject.!(superclass)));

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                CREATE_OBJECT => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def top = stack.pop();
                    assertType(ClassObjects.classClass, top, associatedFunc.label, loc);
                    if (isExn()) {
                        if (CiceroOptions.profileDynamicBytecode) {
                            opExecTime = System.ticksUs() - opExecTime;
                            ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                        }
                        if (CiceroOptions.profileDynamicOpcodePair){
                            dispatchStartTime = System.ticksUs();
                        }
                        continue;
                    }

                    // duplicated code
                    def clsObj = ClassObject.!(top);
                    def obj = Objects.newObject(clsObj);

                    def classes: Vector<ClassObject> = Vector.new();
                    for (cls = clsObj; cls != null; cls = cls.superclass)
                        classes.put(cls);
                
                    // initialization order is from base class downwards, which
                    // may involve reinitializing some fields
                    def classInitFOs : Vector<FuncObject> = Vector.new();
                    def args = [("self", obj)];
                    for (cls in classes.reverse().extract()) {
                        // call initializer (initialize fields as well)
                        if (cls.init != null) {
                            def initFn = cls.init;
                            match (initFn.code.code) {
                                Bytecode => classInitFOs.put(initFn);
                                _ => {
                                    // create new frames here!
                                    def frame = FrameObjects.newFrame(null, Strings.format1("%s.init", cls.name), initFn.code, args, []);

                                    if (CiceroOptions.profileDynamicBytecode) {
                                        opExecTime = System.ticksUs() - opExecTime;
                                        ProfileBytecode.profileDynamicExecutionTime(opcode.tag, opExecTime);
                                    }

                                    frame.eval();

                                    if (CiceroOptions.profileDynamicBytecode) {
                                        opExecTime = System.ticksUs();
                                    }

                                    if (frame.isExn()) {
                                        rethrow(frame.getExn(), associatedFunc.label, loc);
                                        continue;
                                    }
                                }
                            }

                        } 
                    }
                    stack.push(obj);

                    // setup new `InitCallFrame` if init bytecode objects to execute
                    if (classInitFOs.length > 0){
                        // save current caller state
                        saveFrame(pc, loc);

                        // sync local variables for the new executing init-callee frame
			            def initFO = classInitFOs[0];
			            def bytecode = Code.Bytecode.!(initFO.code.code).bytecode;
                        b = bytecode;
                        code = b.instrs;
                        pc = 0;
                        baseStartIndex = stack.top - 1; // `self` is on the stack
                        localsStartIndex = baseStartIndex;
                        nonLocalsStartIndex = localsStartIndex + bytecode.locals.length; // classes don't capture nonlocals.
                        associatedFunc = initFO.metadata;
                        
                        // grow stack (if needed for remaining local variables)
                        stack.resize(nonLocalsStartIndex);

                        callFrames.push(InitCallFrame.new(b, classInitFOs.extract(), baseStartIndex, initFO.metadata));
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                LOAD_FIELD => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def obj = stack.pop();
                    def field = b.stringPool[operand];

                    if (CLOptions.CACHE.get()) {
                        def idx = (pc - 4) >> 2;
                        cache = b.cache[idx];
                        
                        def cls : ClassObject = obj.getClass();
                        match (cache){
                            Uncached => {
                                // cache miss
                                def v = obj.getField(field);
                                if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                else {
                                    stack.push(v);
                                    // transition to monomorphic state(initial cached state)
                                    b.cache[idx] = CacheState.Monomorphic(cls, obj.getIndex(field));
                                }

                                if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                            }
                            Monomorphic(cachedClass, cachedIndex) => {
                                if (cachedClass == cls) {
                                    def res = obj.getFieldByIndex(cachedIndex);
                                    if (CiceroOptions.useLazyMethods && res == null) {
                                        // if not yet initialized, must treat as cache miss
                                        stack.push(obj.getField(field));
                                        // don't transition state
                                        if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, false);
                                    } else {
                                        // cache hit
                                        stack.push(res);
                                        if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheHit(b, pc-4);
                                    }
                                } else {
                                    // cache miss
                                    def v = obj.getField(field);
                                    if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                    else {
                                        stack.push(v);

                                        // Transition to Polymorphic state
                                        // store newly seen class, and also previously cached class
                                        def picArray: Array<(ClassObject, int)> = Array.new(InlineCache.picLimit);
                                        picArray[0] = (cls, obj.getIndex(field));
                                        picArray[1] = (cachedClass, cachedIndex);
                                        b.cache[idx] = CacheState.Polymorphic(picArray);
                                    }

                                    if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                }
                            }
                            Polymorphic(values)=> {
                                var needToChangeState: bool = true;
                                for (i < values.length){
                                    def cachedClass : ClassObject = values[i].0;
                                    if (cachedClass == cls){
                                        def cachedIndex : int = values[i].1;
                                        def res = obj.getFieldByIndex(cachedIndex);
                                        if (CiceroOptions.useLazyMethods && res == null) {
                                            // if not yet initialized, must treat as cache miss
                                            stack.push(obj.getField(field));
                                            // don't transition state
                                            if (CiceroOptions.profileInlineCaching) {
                                                ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, false);
                                            }
                                        } else {
                                            // cache hit
                                            stack.push(res);
                                            if (CiceroOptions.profileInlineCaching) {
                                                ProfileInlineCache.profileCacheHit(b, pc-4);
                                            }
                                        }

                                        needToChangeState = false;
                                        break;

                                    } else if (cachedClass == null) {
                                        // cache miss
                                        def v = obj.getField(field);
                                        if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                        else {
                                            stack.push(v);
                                            values[i] = (cls, obj.getIndex(field));
                                        }

                                        if (CiceroOptions.profileInlineCaching) {
                                            ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                        }

                                        needToChangeState = false;
                                        break;
                                    }
                                }
                                
                                if (needToChangeState){
                                    def v = obj.getField(field);
                                    if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                    else {
                                        stack.push(v);
                                        // transition to megamorphic state
                                        b.cache[idx] = CacheState.Megamorphic;
                                    }

                                    if (CiceroOptions.profileInlineCaching) {
                                        ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                    }
                                }
                            }
                            Megamorphic => {
                                // perform expensive lookup
                                def v = obj.getField(field);
                                if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                else stack.push(v);

                                // treat every megamorphic state cache lookup as a cache miss
                                if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, false);
                            }
                        }
                    } else {
                        def v = obj.getField(field);
                        if (v == null) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                        else stack.push(v);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                STORE_FIELD => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def val = stack.pop();
                    def obj = stack.pop();
                    def field = b.stringPool[operand];

                    if (CLOptions.CACHE.get()) {
                        def idx = (pc - 4) >> 2;
                        cache = b.cache[idx];
                        
                        def cls : ClassObject = obj.getClass();
                        // obj.initClass() is guaranteed to have executed
                        // So, an index is guaranteed to exist for the field, given that the field exists.

                        match (cache){
                            Uncached => {
                                /* cache miss */
                                if (!obj.setField(field, val)) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                else {
                                    // transition to monomorphic
                                    b.cache[idx] = CacheState.Monomorphic(cls, obj.getIndex(field));

                                    if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                }
                            }
                            Monomorphic(cachedClass, cachedIndex) => {
                                if (cachedClass == cls) {
                                    /* cache hit */
                                    // field exists since exception would have occured on initial cache miss otherwise
                                    obj.setFieldByIndex(cachedIndex, val);
                                    if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheHit(b, pc-4);

                                } else {
                                    /* cache miss */
                                    if (!obj.setField(field, val)) {
                                        throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                    } else {
                                        // Transition to Polymorphic state
                                        // store newly seen class, and also previously cached class
                                        def picArray: Array<(ClassObject, int)> = Array.new(InlineCache.picLimit);
                                        picArray[0] = (cls, obj.getIndex(field));
                                        picArray[1] = (cachedClass, cachedIndex);
                                        b.cache[idx] = CacheState.Polymorphic(picArray);

                                        if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                    }
                                }
                            }
                            Polymorphic(values)=> {
                                var needToChangeState: bool = true;
                                for (i < values.length){
                                    def cachedClass : ClassObject = values[i].0;

                                    if (cachedClass == cls){
                                        needToChangeState = false;
                                        // cached index = values[i].1
                                        obj.setFieldByIndex(values[i].1, val);
                                        if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheHit(b, pc-4);
                                        break;

                                    } else if (cachedClass == null) {
                                        needToChangeState = false;

                                        if (!obj.setField(field, val)) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                        else {
                                            values[i] = (cls, obj.getIndex(field));
                                            if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                        }
                                        break;
                                    }
                                }
                                
                                if (needToChangeState){
                                    if (!obj.setField(field, val)) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                    else {
                                        b.cache[idx] = CacheState.Megamorphic;
                                        if (CiceroOptions.profileInlineCaching) {
                                            ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, true);
                                        }
                                    }
                                }
                            }
                            Megamorphic => {
                                // perform expensive method call
                                if (!obj.setField(field, val)) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                                else {
                                    // treat every megamorphic state cache lookup as a cache miss
                                    if (CiceroOptions.profileInlineCaching) ProfileInlineCache.profileCacheMiss(b, pc-4, opcode.name, associatedFunc, false);
                                }
                            }
                        }
                    } else {
                        if (!obj.setField(field, val)) throw(Exceptions.missingField(obj, field), associatedFunc.label, loc);
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                CREATE_LIST => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def values: Vector<Object> = Vector.new();
                    for (i < operand) {
                        values.put(stack.pop());
                    }
                    values.reverse();

                    def obj = ListObject.new();
                    obj.list.puta(values.extract());

                    stack.push(obj);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                CREATE_FUNC => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    def funchole = b.funcPool[operand];

                    def nonlocals: Array<(string, Object)> = Array.new(funchole.nonlocals.length);

                    def fn = FuncObjects.newFO(funchole.id, funchole.params, nonlocals, funchole.body, funchole.metadata);
                    for (i = funchole.nonlocals.length - 1; i >= 0; i--) {
                        // if the nonlocal is the function itself (for recursion) then do not
                        // get it from the stack. you already have it!
                        if (Strings.equal(funchole.nonlocals[i], funchole.id)) {
                            nonlocals[i] = (funchole.id, fn);
                        } else {
                            nonlocals[i] = (funchole.nonlocals[i], stack.pop());
                        }
                    }

                    stack.push(fn);

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                    if (CiceroOptions.profileDynamicOpcodePair){
                        dispatchStartTime = System.ticksUs();
                    }
                }
                RETURN => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    // return value will be on top of the stack
                    // put the return value as the base of the current call frame
                    def returnValue = stack.pop();
                    stack.elems[baseStartIndex] = returnValue;
                    stack.resize(baseStartIndex + 1);

                    // finished with the current call frame. pop it and set the executing frame to the caller frame.
                    callFrames.pop();

                    if (callFrames.empty()){
                        // return from top-level code
                        result = Result.Return(returnValue);
                        if (CiceroOptions.profileDynamicBytecode) {
                            opExecTime = System.ticksUs() - opExecTime;
                            ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                        }
                        return null;
                    } else {
                        def currentCallFrame = callFrames.peek();
                        
                        // Sync the local variables relevant to the currently executing frame
                        b = currentCallFrame.b;
                        code = b.instrs;
                        pc = currentCallFrame.ip;
                        localsStartIndex = currentCallFrame.localsStartIndex;
                        nonLocalsStartIndex = currentCallFrame.nonLocalsStartIndex;
                        baseStartIndex = currentCallFrame.baseStartIndex;
                        loc = currentCallFrame.loc;
                        associatedFunc = currentCallFrame.associatedFunc;
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                }
                RETURN_INIT => {
                    if (CiceroOptions.profileDynamicOpcodePair){
                        def dispatchEndTime = System.ticksUs();
                        ProfileDynamicOpcodePair.profile(lastInstr, opcode, dispatchEndTime - dispatchStartTime);
                    }
                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs();
                    }

                    // sanity check make sure currentCallFrame is initCallFrame
                    def initCallFrame = InitCallFrame.!(callFrames.peek());
                    def newIndex = initCallFrame.currentIndex + 1;
                    if (newIndex < initCallFrame.initFOs.length){
                        def initFO = initCallFrame.initFOs[newIndex];
                        // no need to pop the call frame
                        // update all necessary local variables
                        def bytecode = Code.Bytecode.!(initFO.code.code).bytecode;
                        b = bytecode;
                        code = b.instrs;
                        pc = 0;
                        nonLocalsStartIndex = localsStartIndex + bytecode.locals.length; // classes don't capture nonlocals.
                        loc = b.sourceMap[0];
                        associatedFunc = initFO.metadata;

                        // grow stack (if needed for remaining local variables)
                        stack.resize(nonLocalsStartIndex);

                        // update the current init FO index
                        InitCallFrame.!(callFrames.elems[callFrames.top -1]).currentIndex = newIndex;
                        
                        // reuse the same existing init call frame (no need to pop frame)
                        // but update the contents of the frame
                        updateInitFrame(b, pc, associatedFunc, loc);
                    } else {
                        // treat like a normal `RETURN` instruction
                        // done with init frames
                        callFrames.pop();
                        stack.resize(baseStartIndex + 1);

                        def currentCallFrame = callFrames.peek();
                        
                        // Sync the local variables relevant to the currently executing frame
                        b = currentCallFrame.b;
                        code = b.instrs;
                        pc = currentCallFrame.ip;
                        localsStartIndex = currentCallFrame.localsStartIndex;
                        nonLocalsStartIndex = currentCallFrame.nonLocalsStartIndex;
                        baseStartIndex = currentCallFrame.baseStartIndex;
                        loc = currentCallFrame.loc;
                        associatedFunc = currentCallFrame.associatedFunc;
                    }

                    if (CiceroOptions.profileDynamicBytecode) {
                        opExecTime = System.ticksUs() - opExecTime;
                        ProfileBytecode.profileDynamicCountAndExecutionTime(opcode.tag, opExecTime);
                    }
                }
                // _ => System.error("eval error", "unsupported opcode");
            }
            if (CiceroOptions.profileJumpOutcomes) {
                match (opcode) {
                    JUMP, JUMP_IF_FALSE, JUMP_IF_TRUE_PEEK, JUMP_IF_FALSE_PEEK => {
                        def jump_taken = opcode_pc != (pc - 4);
                        ProfileJumpOutcomes.profileJump(b, opcode_pc, opcode.name, jump_taken, associatedFunc);
                    }
                    _ => {}
                }
            }
            // SUPREME: TODO: NOT ACCURATE when a new function gets called
            lastInstr = Maybe.Just(opcode);
        }

        if (CiceroOptions.sanityChecks && stack.empty()) System.error("eval error", "stack is empty");
        if (CiceroOptions.traceBytecodeEvaluation) System.puts("RETURN\n");
        return stack.pop();
    }

    def reset(){
        callFrames.clear();
        handlers.clear();
        stack.clear();
        result = Result.Uncomputed;
    }

    /* Call frame related helper methods */
    def saveFrame(pc: int, loc: FileRange){
        // update the ip in the caller frame!
        def i = callFrames.top - 1;
        callFrames.elems[i].ip = pc;
        callFrames.elems[i].loc = loc;
    }

    def updateInitFrame(b: Bytecode, pc: int, associatedFunc: FunctionProfileMetadata, loc: FileRange){
        def i = callFrames.top - 1;
        // `bytecode`, `associatedFunc` are also necessary to save during init calls since we reuse the call frame
        callFrames.elems[i].b = b; 
        callFrames.elems[i].associatedFunc = associatedFunc;
        // TODO? -> not necessary to save yet since init don't capture nonlocals, but potentially might need to in the future if classes capture nonlocals
        saveFrame(pc, loc);
    }

	/* Exception helper methods */

	def isExn() -> bool {
		return Result.Exn.?(result);
	}

	def getExn() -> ExnObject {
		match (result) {
			e: Result.Exn    => return e.exn;
			_ => System.error("internal error", "FrameObject.getExn: received non-exn result");
		}
		return null;
	}

	def assertArity(argc: int, vals: int, label: string, loc: FileRange) {
		if (vals != argc)
			throw(Exceptions.arityMismatch(argc, vals), label, loc);
	}

	def rethrow(exn: ExnObject, label: string, loc: FileRange) {
		exn.stacktrace.put((label, loc));
		result = Result.Exn(exn);
	}

	def assertType(exp: ClassObject, val: Object, label: string, loc: FileRange) {
		if (!val.instanceOf(exp))
			throw(Exceptions.typeMismatch(exp, val), label, loc);
	}

	def throw(msg: string, label: string, loc: FileRange) {
		result = Result.Exn(ExnObjects.fromStrObject(StrObjects.fromString(msg), label, loc));
	}

    /* Generic bytecode rewriting function */

    def rewriteBytecode(code: Array<byte>, op_index: int, new_op: Opcode, operand: int){
        // replace opcode
        code[op_index] = new_op.tag;

        // Little endian representation used to store the `operand` in bytecode
        code[op_index + 1] = byte.!(operand & 0xFF);
        code[op_index + 2] = byte.!((operand >> 8) & 0xFF);
        code[op_index + 3] = byte.!((operand >> 16) & 0xFF);
    }
}
class WasmFrame extends FrameObject {

	new(prev: FrameObject, code: CodeObject, args: Array<(string, Object)>, nonlocalArgs: Array<(string, Object)>) super(prev, code, args) {
		if (code != null) {
			wasm = Code.Wasm.!(code.code).wasm;
			nonlocals = nonlocalArgs;
			// XXX can do better here
// 			Array.new(wasm.nonlocals.length);
// 			for (i < wasm.nonlocals.length) {
// 				def id = wasm.nonlocals[i];
// 				// search for id in nonlocal args
// 				var found: bool;
// 				for (p in nonlocalArgs) {
// 					if (Strings.equal(id, p.0)) {
// 						nonlocals[i] = p;
// 						found = true;
// 						break;
// 					}
// 				}
// 				if (!found) {
// 					// might this ever happen?
// 					System.error("eval error", "unable to unify nonlocal arguments");
// 				}
// 			}
		}
	}

	def var wasm: WasmBytecode;
	def var nonlocals: Array<(string, Object)>;

	def eval() {
		/* swap runtime components */
		def oldFrame      = WasmRuntime.frame;
		def oldStrings    = WasmRuntime.strings;
		def oldFuncholes  = WasmRuntime.funcholes;
		def oldClassholes = WasmRuntime.classholes;
		def oldObjects    = WasmRuntime.objects;
		def oldRefcounts  = WasmRuntime.refcounts;
		def oldFreelist   = WasmRuntime.freelist;
		def oldConstPoolLen = WasmRuntime.constPoolLen;
		def oldConstsPtr  = WasmRuntime.constsPtr;
		def oldResult     = WasmRuntime.result;

		WasmRuntime.frame      = this;
		WasmRuntime.strings    = wasm.stringPool;
		WasmRuntime.funcholes  = wasm.funcPool;
		WasmRuntime.classholes = wasm.classPool;
		// Shadow-stack mode never touches WasmRuntime.objects/refcounts/freelist
		// (it passes raw pointers, not objects-vector indices) - skip allocating
		// them on every single call in that mode; only constsPtr is needed.
		if (!CiceroOptions.useShadowStack) {
			WasmRuntime.objects    = Vectors.ofN(wasm.constPool); // XXX could be destructive? but I don't think so
			WasmRuntime.refcounts  = Vectors.ofN(Array<int>.new(wasm.constPool.length));
			WasmRuntime.freelist   = ArrayStack.new();
		}
		WasmRuntime.constPoolLen = wasm.constPool.length;
		WasmRuntime.constsPtr  = wasm.constPool; // shadow-stack mode only; harmless to set otherwise
		WasmRuntime.result     = 0;

		// Shadow-stack mode passes raw pointers (WasmRuntime.objToPtr), not
		// WasmRuntime.objects indices - CiceroOptions.useShadowStack is a
		// compile-time constant, so only one side of each `if` here actually
		// ships in a given build.
		var arg0: int = if(args.length > 0, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[0].1), WasmRuntime.alloc(args[0].1)));
		var arg1: int = if(args.length > 1, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[1].1), WasmRuntime.alloc(args[1].1)));
		var arg2: int = if(args.length > 2, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[2].1), WasmRuntime.alloc(args[2].1)));
		var arg3: int = if(args.length > 3, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[3].1), WasmRuntime.alloc(args[3].1)));
		var arg4: int = if(args.length > 4, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[4].1), WasmRuntime.alloc(args[4].1)));
		var arg5: int = if(args.length > 5, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[5].1), WasmRuntime.alloc(args[5].1)));
		var arg6: int = if(args.length > 6, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[6].1), WasmRuntime.alloc(args[6].1)));
		var arg7: int = if(args.length > 7, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[7].1), WasmRuntime.alloc(args[7].1)));
		var arg8: int = if(args.length > 8, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[8].1), WasmRuntime.alloc(args[8].1)));
		var arg9: int = if(args.length > 9, if(CiceroOptions.useShadowStack, WasmRuntime.objToPtr(args[9].1), WasmRuntime.alloc(args[9].1)));

		var exn: bool;
		match (wasm.f) {
			Func0(f) => exn = f();
			Func1(f) => exn = f(arg0);
			Func2(f) => exn = f(arg0, arg1);
			Func3(f) => exn = f(arg0, arg1, arg2);
			Func4(f) => exn = f(arg0, arg1, arg2, arg3);
			Func5(f) => exn = f(arg0, arg1, arg2, arg3, arg4);
			Func6(f) => exn = f(arg0, arg1, arg2, arg3, arg4, arg5);
			Func7(f) => exn = f(arg0, arg1, arg2, arg3, arg4, arg5, arg6);
			Func8(f) => exn = f(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7);
			Func9(f) => exn = f(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
			FuncN(f) => {
				// >9-param entry point. Shadow-stack mode uses xargsObjs (real,
				// GC-scanned Objects - args[9+i].1 is already one, no raw-pointer
				// round-trip needed) instead of xargs (a plain ArrayStack<int>,
				// unsafe for raw pointers - see xargsObjs's own doc comment).
				// baseDepth, not empty(): an outer call's pending rest-args may be under ours.
				if (CiceroOptions.useShadowStack) {
					def baseDepth = WasmRuntime.xargsObjs.top;
					def numRest = args.length - 9;
					for (i < numRest)
						WasmRuntime.xargsObjs.push(args[9 + i].1);
					exn = f(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
					if (CiceroOptions.sanityChecks && WasmRuntime.xargsObjs.top != baseDepth) {
						System.puts("internal error: WasmRuntime.xargsObjs did not return to its pre-call depth\n");
						System.error("internal error", "WasmRuntime.xargsObjs did not return to its pre-call depth");
					}
				} else {
					def baseDepth = WasmRuntime.xargs.top;
					def numRest = args.length - 9;
					for (i < numRest)
						WasmRuntime.xargs.push(WasmRuntime.alloc(args[9 + i].1));
					exn = f(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
					if (CiceroOptions.sanityChecks && WasmRuntime.xargs.top != baseDepth) {
						System.puts("internal error: WasmRuntime.xargs did not return to its pre-call depth\n");
						System.error("internal error", "WasmRuntime.xargs did not return to its pre-call depth");
					}
				}
			}
		}
		def resultObj = if(CiceroOptions.useShadowStack, WasmRuntime.ptrToObj(WasmRuntime.result), WasmRuntime.objects[WasmRuntime.result]);
		if (exn) {
			result = Result.Exn(ExnObject.!(resultObj));
		} else {
			result = Result.OK(resultObj);
		}

		/* unswap runtime components */
		WasmRuntime.frame      = oldFrame;
		WasmRuntime.strings    = oldStrings;
		WasmRuntime.funcholes  = oldFuncholes;
		WasmRuntime.classholes = oldClassholes;
		WasmRuntime.objects    = oldObjects;
		WasmRuntime.refcounts  = oldRefcounts;
		WasmRuntime.freelist   = oldFreelist;
		WasmRuntime.constPoolLen = oldConstPoolLen;
		WasmRuntime.constsPtr  = oldConstsPtr;
		WasmRuntime.result     = oldResult;
	}

	def evalCode(code: CodeObject) -> Object {
		WasmRuntime.frame      = this;
		WasmRuntime.result     = 0;
		def wasm = Code.Wasm.!(code.code).wasm;
		WasmRuntime.strings    = wasm.stringPool;
		WasmRuntime.funcholes  = wasm.funcPool;
		WasmRuntime.classholes = wasm.classPool;
		// See eval()'s identical comment: shadow-stack mode never touches
		// objects/refcounts/freelist.
		if (!CiceroOptions.useShadowStack) {
			WasmRuntime.objects    = Vectors.ofN(wasm.constPool); // XXX could be destructive? but I don't think so
			WasmRuntime.refcounts  = Vectors.ofN(Array<int>.new(wasm.constPool.length));
			WasmRuntime.freelist   = ArrayStack.new();
		}
		WasmRuntime.constPoolLen = wasm.constPool.length;
		WasmRuntime.constsPtr  = wasm.constPool; // shadow-stack mode only; harmless to set otherwise
		match (wasm.f) {
			Func0(f) => {
				def exn = f();
				def resultObj = if(CiceroOptions.useShadowStack, WasmRuntime.ptrToObj(WasmRuntime.result), WasmRuntime.objects[WasmRuntime.result]);
				if (exn) {
					result = Result.Exn(ExnObject.!(resultObj));
				} else {
					result = Result.OK(resultObj);
				}
				match (result) {
					OK(o) => return o;
					Exn(e) => return null;
					Return(r) => return r; // TODO should this be possible?
					Uncomputed => {
						System.puts("evalCode in WasmFrame returned Uncomputed\n");
						System.error("internal error", "evalCode in WasmFrame returned Uncomputed\n");
					}
				}
			}
			_ => {
				// maybe should not happen?
				System.puts("unimplemented: WasmFrame.eval: FuncN (N != 0)\n");
				System.error("unimplemented", "WasmFrame.eval: FuncN (N != 0)");
			}
		}
		return null;
	}

	def getGlobal(id: string) -> Object {
		return Globals.loadGlobal(id).maybe(null, fun(p: (Object, int)) => p.0);
	}

	def getNonlocal(id: string) -> Object { // FIXME don't use string
		for (p in nonlocals) {
			if (Strings.equal(p.0, id)) return p.1;
		}
		System.puts(Strings.format1("cannot find nonlocal %s\n", id));
		System.error("internal error", "cannot find nonlocal");
		return null;
	}

	def setGlobal(id: string, obj: Object) -> Object {
		Globals.storeGlobal(id, obj);
		return obj;
	}
}

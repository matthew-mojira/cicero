class WasmCompiler {
	private new() {}

	def compile() -> WasmBytecode {
		System.error("WasmCompiler", "compiling to wasm not supported on this target");
		return null;
	}
}

class WasmBytecodeCompiler extends WasmCompiler {
	new(ast: AST, params: Array<string>, label: string) super() {}
}

class WasmASTCompiler extends WasmCompiler {
	new(ast: AST, params: Array<string>, label: string) super() {}
}

class WasmShadowStackCompiler extends WasmCompiler {
	new(ast: AST, params: Array<string>, label: string) super() {}
}

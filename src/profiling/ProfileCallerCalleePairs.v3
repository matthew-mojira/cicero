// Used during `profileCallerCalleePairs`
class ProfiledCallerCalleeData #unboxed {
	def callerLabel: string;
	def calleeLabel: string;
	var counts: int; // # of calls to the callee from the caller
	var time: int; // inclusive execution time of the callee(μs)

	new(callerLabel, calleeLabel, counts, time) {}
}

component ProfileCallerCalleePairs {
	/* 
	 	Each user defined function/method as well as built in function/methods are given an unique identifier id before run time.
		key: long = (caller.identifier_id << 32) | callee.identifier_id;
	*/
	def data: HashMap<long, ProfiledCallerCalleeData> = HashMap.new(int.view<long>, long.==);

	def profilePair(caller: FunctionProfileMetadata, callee: FunctionProfileMetadata, time: int) {
		def key: long = ProfilingHelpers.constructLong(caller.identifier, callee.identifier);
		if (ProfileCallerCalleePairs.data.has(key)) {
			def data: ProfiledCallerCalleeData = ProfileCallerCalleePairs.data[key];
			data.counts += 1; // increment calls
			data.time += time;
		} else {
			ProfileCallerCalleePairs.data[key] = ProfiledCallerCalleeData.new(caller.label, callee.label, 1, time);
		}
	}

	def printStats() {
		def sb = StringBuilder.new();
		sb.puts("# Execution time is the total time spent inside the callee\n");
		sb.puts("caller identifier id, caller label, callee identifier id, callee label, calls, execution time(μs)\n");
		for (list = Maps.keyList(ProfileCallerCalleePairs.data); list != null; list = list.tail) {
			def key: long = list.head;
			def callerIdentifierId: int = int.!(key >> 32);
			def calleeIdentifierId: int = int.!(key & 0x00000000FFFFFFFF);
			
			def data: ProfiledCallerCalleeData = ProfileCallerCalleePairs.data[key];

			sb.put2("%d, %s, ", callerIdentifierId, data.callerLabel);
			sb.put2("%d, %s, ", calleeIdentifierId, data.calleeLabel);
			sb.put2("%d, %d\n", data.counts, data.time);
		}
		System.puts(sb.extract());
	}
}
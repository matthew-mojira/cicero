component ProfileDynamicOpcodePair {

	/* 
		e.g ProfileDynamicOpcodePair.counts[Opcode.LOAD_LOCAL.tag][Opcode.LOAD_CONST.tag]
			would track dynamic counts of LOAD_LOCAL followed by LOAD_CONST
	*/
	def counts: Array<Array<int>>= ProfilingHelpers.createMatrix(Opcodes.numOpcodes, Opcodes.numOpcodes);
	/* 
		e.g ProfileDynamicOpcodePair.dispatchCost[Opcode.LOAD_LOCAL.tag][Opcode.LOAD_CONST.tag]
			would track the total dispatch cost from LOAD_LOCAL to LOAD_CONST
	*/
	def dispatchCost: Array<Array<long>>= ProfilingHelpers.createMatrix(Opcodes.numOpcodes, Opcodes.numOpcodes);

	def profile(maybeOpOne: Maybe<Opcode>, opTwo: Opcode, dispatchCost: long) {
		match (maybeOpOne) {
			Nothing => {}
			Just(opOne) => {
				ProfileDynamicOpcodePair.counts[opOne.tag][opTwo.tag]++;
				ProfileDynamicOpcodePair.dispatchCost[opOne.tag][opTwo.tag] += dispatchCost;
			}
		}
	}

	def printStats() {
		def sb = StringBuilder.new();
		sb.puts("# Omitting opcode pairs executed zero times\n");
		sb.puts("opcode, next opcode, counts, total dispatch cost(μs)\n");
		for (row=0; row < Opcodes.numOpcodes; row++) {
			for (col=0; col < Opcodes.numOpcodes; col++) {
				def counts: int = ProfileDynamicOpcodePair.counts[row][col];
				def dispatchCost: long = ProfileDynamicOpcodePair.dispatchCost[row][col];
				if (counts != 0) {
					sb.put2("%s, %s, ", Opcodes.map[row].name, Opcodes.map[col].name);
					sb.put2("%d, %s\n", counts, ProfilingHelpers.longToString(dispatchCost));
				}
			}
		}
		System.puts(sb.extract());
	}
}
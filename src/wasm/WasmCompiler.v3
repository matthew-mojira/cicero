/* RUNTIME DEFINITIONS */
def IS_NULL: u32       = u32.view(CiWasmTarget.functionId(WasmRuntime.isNull));
def IS_NOT_NULL: u32   = u32.view(CiWasmTarget.functionId(WasmRuntime.isNotNull));
def GET_GLOBAL: u32    = u32.view(CiWasmTarget.functionId(WasmRuntime.getGlobal));
def GET_GLOBAL_BY_INDEX: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.getGlobalByIndex));
def GET_NONLOCAL: u32  = u32.view(CiWasmTarget.functionId(WasmRuntime.getNonlocal));
def SET_GLOBAL: u32    = u32.view(CiWasmTarget.functionId(WasmRuntime.setGlobal));
def SET_GLOBAL_BY_INDEX: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.setGlobalByIndex));
def IS_TRUE: u32       = u32.view(CiWasmTarget.functionId(WasmRuntime.isTrue));
def IS_FALSE: u32      = u32.view(CiWasmTarget.functionId(WasmRuntime.isFalse));
def IS_FUNC: u32       = u32.view(CiWasmTarget.functionId(WasmRuntime.isFunc));
def IS_CLASS: u32      = u32.view(CiWasmTarget.functionId(WasmRuntime.isClass));
def IS_STRING: u32     = u32.view(CiWasmTarget.functionId(WasmRuntime.isString));

def RAISE_TYPE: u32    = u32.view(CiWasmTarget.functionId(WasmRuntime.raiseTypeException));
def RAISE_STRING: u32  = u32.view(CiWasmTarget.functionId(WasmRuntime.raiseString));
def RAISE_FIELD: u32   = u32.view(CiWasmTarget.functionId(WasmRuntime.raiseMissingField));

def CALL_FUNC0: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc0));
def CALL_FUNC1: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc1));
def CALL_FUNC2: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc2));
def CALL_FUNC3: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc3));
def CALL_FUNC4: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc4));
def CALL_FUNC5: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc5));
def CALL_FUNC6: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc6));
def CALL_FUNC7: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc7));
def CALL_FUNC8: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc8));
def CALL_FUNC9: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFunc9));
def PUSH_ARG:   u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.pushArg));
def POP_ARG:    u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.popArg));
def CALL_FUNC_REST: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.callFuncRest));

def GET_RESULT: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.getResult));
def SET_RESULT: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.setResult));

def CREATE_FUNC0: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc0));
def CREATE_FUNC1: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc1));
def CREATE_FUNC2: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc2));
def CREATE_FUNC3: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc3));
def CREATE_FUNC4: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc4));
def CREATE_FUNC5: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc5));
def CREATE_FUNC6: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc6));
def CREATE_FUNC7: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc7));
def CREATE_FUNC8: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc8));
def CREATE_FUNC9: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFunc9));
def CREATE_FUNC_REST: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createFuncRest));

def GET_FIELD: u32    = u32.view(CiWasmTarget.functionId(WasmRuntime.getField));
def SET_FIELD: u32    = u32.view(CiWasmTarget.functionId(WasmRuntime.setField));

def CREATE_CLASS:  u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createClass));
def CREATE_OBJECT: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createObject));

def CREATE_LIST0: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList0));
def CREATE_LIST1: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList1));
def CREATE_LIST2: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList2));
def CREATE_LIST3: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList3));
def CREATE_LIST4: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList4));
def CREATE_LIST5: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList5));
def CREATE_LIST6: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList6));
def CREATE_LIST7: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList7));
def CREATE_LIST8: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList8));
def CREATE_LIST9: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createList9));
def CREATE_LIST_REST: u32 = u32.view(CiWasmTarget.functionId(WasmRuntime.createListRest));

def compileFromTier1 = true;

class WasmCompiler {
	// TODO need extra information about parameters and locals
	// TODO get better wasm code generator (use Aeneas?)
	def wasm: DataWriter = DataWriter.new();
	def params: Array<string>;
	def var scratch0: u32;
	def var scratch1: u32;
	def argScratch: Array<u32> = Array.new(9); // reorder buffer for <=9-arity RTS calls

	def var ciceroBytecode: Bytecode;

	new(ast: AST, params) {
		addConst(null); // XXX what is this?

		scratch0 = addLocal("<receiver>"); /* also used as scratch */
		// XXX Virgil calling convention always requires a receiver object as the first argument

		wasm.put_uleb32(1); // 1 set of
		def hole = wasm.skip_leb32();
		wasm.putb(0x7F);    // i32

		if (compileFromTier1) {
			ciceroBytecode = BytecodeCompiler.new(ast, params).extract();
			if (CiceroOptions.optimizeBytecode) {
				ciceroBytecode.optimize();
			}
			locals.puta(ciceroBytecode.locals); // XXX everything off by 1!!
			nonlocals.puta(ciceroBytecode.nonlocals);
			consts.puta(ciceroBytecode.constPool); // XXX everything off by 1!!
			strings.puta(ciceroBytecode.stringPool);
			classholes.puta(ciceroBytecode.classPool);
			funcholes.puta(ciceroBytecode.funcPool);

			scratch1 = addLocal("<scratch1>"); // appended last; doesn't shift the offsets above
			for (i < 9) argScratch[i] = addLocal(Strings.format1("<arg%d>", i));


			def br = BeyondRelooper.new(CFGraph.new(ciceroBytecode));
			br.structuredControl();

			if (CiceroOptions.traceWasmCompilation) {
				System.puts("=== WasmCompiler: params=[");
				for (i < params.length) {
					if (i > 0) System.puts(", ");
					System.puts(params[i]);
				}
				System.puts("]\n--- bytecode ---\n");
				ciceroBytecode.inspect();
				System.puts("--- wasm structure ---\n");
				br.display();
				System.puts("---\n");
			}

			compileWasmStructure(br.output);
		} else {
			Arrays.map(params, addLocal); // XXX different behavior on duplicated locals? or parser should forbid?
			scratch1 = addLocal("<scratch>");

			// FUNCTION BODY
			withBlock<void, int>(fun {
				handlerStack.push(blockDepth);

				// initialize extra parameters (beyond 9) from WasmRuntime.xargs.
				// xargs were pushed left-to-right, so pop in reverse to fill
				// the tail of the parameter locals first.
				if (params.length > 9) {
					for (i = params.length - 1; i >= 9; i--) {
						emitCall(POP_ARG);
						wasm.putb(WasmOp.SET_LOCAL.opcode);
						wasm.put_uleb32(u32.view(1 + i)); // skip <receiver> at slot 0
					}
				}

				compileAST(ast);
				
				emitCall(SET_RESULT);

				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.putb(0); // OK
				wasm.putb(WasmOp.RETURN.opcode); 
				wasm.putb(WasmOp.UNREACHABLE.opcode); 

				handlerStack.pop(); // XXX unnecessary
			});

			emitCall(SET_RESULT);

			wasm.putb(WasmOp.I32_CONST.opcode);
			wasm.putb(1); // exception
		}

		wasm.putb(WasmOp.END.opcode);

		wasm.at(hole);
		wasm.overwrite_uleb32(locals.length);
	}

	// from BytecodeCompiler
	def locals:    Vector<string> = Vector.new();
	def nonlocals: Vector<string> = Vector.new();
	def consts: Vector<Object> = Vector.new();
	def strings: Vector<string> = Vector.new();
	def classholes: Vector<ClassObject -> ClassObject> = Vector.new();
	def funcholes:  Vector<ASTData.Func> = Vector.new();

	def compileWasmStructure(ws: WasmStructure) {
		match (ws) {
			Block(body) => {
				withBlock<void, int>(fun {
					compileWasmStructure(body);
				});
			}
			Loop(body) => {
				withLoop<void, int>(fun {
					compileWasmStructure(body);
				});
			}
			If(bodyFallthrough, bodyBranch) => {
				withIfElse<void, int>(fun {
					compileWasmStructure(bodyFallthrough);
				}, /* else */ fun {
					compileWasmStructure(bodyBranch);
				});
			}
			Br(depth) => {
				wasm.putb(WasmOp.BR.opcode);
				wasm.put_uleb32(u32.!(depth));
			}
			Actions(actions) => compileActions(actions);
			Seq(fst, snd) => {
				compileWasmStructure(fst);
				compileWasmStructure(snd);
			}
			ReturnWithValue => {
				emitCall(SET_RESULT);

				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.putb(0); // OK
				wasm.putb(WasmOp.RETURN.opcode); 
				wasm.putb(WasmOp.UNREACHABLE.opcode); 
			}
			ReturnWithException => {
				emitCall(SET_RESULT);

				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.putb(1); // exception — falls through to function-level end
			}

		}
	}

	def compileActions(bb: BasicBlock) {
		def bc = Ranges.dup(bb.bytes);
		var pc = 0;
		while (pc < bc.length) {
			def ins = Ref<Instruction>.at(bc, pc);
			def opcode = ins.opcode;
			def operand = ins.operand;

			match (opcode) {
				NOP => /* no implementation */ ;
				LOAD_CONST => {
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand + 1); // consts[0] is the reserved null const
				}
				LOAD_GLOBAL => {
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);
					emitCall(GET_GLOBAL);
					emitNullGuard(Exceptions.unboundGlobal(ciceroBytecode.stringPool[operand]));
				}
				LOAD_GLOBAL_BY_INDEX => {
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);
					emitCall(GET_GLOBAL_BY_INDEX);
				}
				LOAD_LOCAL => {
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(u32.!(operand + 1)); // locals[0] is <receiver>
					emitNullGuard(Exceptions.unboundLocal(ciceroBytecode.locals[operand]));
				}
				LOAD_LOCAL_SAFE => {
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(u32.!(operand + 1)); // locals[0] is <receiver>
				}
				LOAD_FIELD => {
					wasm.putb(WasmOp.TEE_LOCAL.opcode);
					wasm.put_uleb32(scratch1);          // stash obj for the error path; [obj]
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);            // [obj, fieldStrIdx]
					emitCall(GET_FIELD);                  // [fieldValueOrNull]
					emitFieldGuard(ciceroBytecode.stringPool[operand]);
				}
				LOAD_NONLOCAL => {
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(addString(ciceroBytecode.nonlocals[operand]));
					emitCall(GET_NONLOCAL);
				}
				STORE_GLOBAL => {
					// value is already pushed, but SET_GLOBAL(strIdx,objIdx) needs the
					// string index first - stash value, push the string, reload it.
					wasm.putb(WasmOp.SET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);
					emitCall(SET_GLOBAL);
					wasm.putb(WasmOp.DROP.opcode); // bytecode's STORE_GLOBAL doesn't push anything back
				}
				STORE_GLOBAL_BY_INDEX => {
					wasm.putb(WasmOp.SET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);
					emitCall(SET_GLOBAL_BY_INDEX);
					wasm.putb(WasmOp.DROP.opcode);
				}
				STORE_LOCAL => {
					wasm.putb(WasmOp.SET_LOCAL.opcode);
					wasm.put_uleb32(u32.!(operand + 1)); // locals[0] is <receiver>
				}
				STORE_FIELD => {
					// stack: [..., val_orig, obj, val_dupe]
					wasm.putb(WasmOp.SET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);          // pop val_dupe; [..., val_orig, obj]
					wasm.putb(WasmOp.SET_LOCAL.opcode);
					wasm.put_uleb32(scratch1);          // pop obj; [..., val_orig]
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(scratch1);          // [..., val_orig, obj]
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(operand);            // [..., val_orig, obj, fieldStrIdx]
					wasm.putb(WasmOp.GET_LOCAL.opcode);
					wasm.put_uleb32(scratch0);          // [..., val_orig, obj, fieldStrIdx, val]
					emitCall(SET_FIELD);                  // [..., val_orig, setFieldResult]
					emitFieldGuard(ciceroBytecode.stringPool[operand]);
				}
				CALL => {
					// fn and args are already on the stack in the order ASSERT_FUNC's
					// preceding opcode and the arg-pushing instructions left them -
					// matches callFuncN's (func, o0, o1, ...) param order directly.
					if (operand <= 9) {
						wasm.putb(WasmOp.CALL.opcode);
						match (operand) {
							0 => wasm.put_uleb32(CALL_FUNC0);
							1 => wasm.put_uleb32(CALL_FUNC1);
							2 => wasm.put_uleb32(CALL_FUNC2);
							3 => wasm.put_uleb32(CALL_FUNC3);
							4 => wasm.put_uleb32(CALL_FUNC4);
							5 => wasm.put_uleb32(CALL_FUNC5);
							6 => wasm.put_uleb32(CALL_FUNC6);
							7 => wasm.put_uleb32(CALL_FUNC7);
							8 => wasm.put_uleb32(CALL_FUNC8);
							9 => wasm.put_uleb32(CALL_FUNC9);
						}
						emitResultGuard();
					} else {
						// same xargs-ordering complication as CREATE_LIST/CREATE_FUNC's
						// >9 cases: args 9..N-1 are already stacked with N-1 on top, but
						// PUSH_ARG needs them fed in forward order. Needs a scratch buffer.
						System.error("compile error", "tier1->Wasm: CALL with >9 arguments unsupported");
					}
				}
				JUMP => /* no implementation */ ;
				JUMP_IF_FALSE => {
					emitCall(IS_TRUE); // bytecode pops unconditionally; flag IS the condition, no value to preserve
				}
				JUMP_IF_TRUE_PEEK => {
					wasmDup();
					emitCall(IS_FALSE); // peek: value rides along unchanged either way
				}
				JUMP_IF_FALSE_PEEK => {
					wasmDup();
					emitCall(IS_TRUE); // peek: value rides along unchanged either way
				}
				RAISE => {
					// bespoke, not a named guard: both arms do real work (unlike
					// emitTypeGuard's passthrough hot arm), and RAISE's flowLeaving
					// is Unconditional (no fallthrough successor at all), so the
					// result is just [exnObj] - no flag.
					wasmDup();
					emitCall(IS_STRING);
					withIfElse<int, int>(fun {
						emitCall(RAISE_STRING);
					}, /* else */ fun {
						emitPushConst(ClassObjects.classStr);
						emitCall(RAISE_TYPE);
					});
				}
				TRY => /* no implementation */ ;
				CATCH => /* no implementation */ ;
				ASSERT_FUNC => {
					emitTypeGuard(IS_FUNC, ClassObjects.classFunc);
				}
				CREATE_OBJECT => {
					emitGuardedCall(IS_CLASS, ClassObjects.classClass, fun {}, CREATE_OBJECT);
				}
				CREATE_CLASS => {
					emitGuardedCall(IS_CLASS, ClassObjects.classClass, fun {
						wasm.putb(WasmOp.I32_CONST.opcode);
						wasm.put_sleb32(operand);
					}, CREATE_CLASS);
				}
				CREATE_LIST => {
					if (operand <= 9) {
						wasm.putb(WasmOp.CALL.opcode);
						match (operand) {
							0 => wasm.put_uleb32(CREATE_LIST0);
							1 => wasm.put_uleb32(CREATE_LIST1);
							2 => wasm.put_uleb32(CREATE_LIST2);
							3 => wasm.put_uleb32(CREATE_LIST3);
							4 => wasm.put_uleb32(CREATE_LIST4);
							5 => wasm.put_uleb32(CREATE_LIST5);
							6 => wasm.put_uleb32(CREATE_LIST6);
							7 => wasm.put_uleb32(CREATE_LIST7);
							8 => wasm.put_uleb32(CREATE_LIST8);
							9 => wasm.put_uleb32(CREATE_LIST9);
						}
					} else {
						// elements are already on the stack with none of them routed through
						// PUSH_ARG; reproducing CREATE_LIST_REST's xargs ordering for >9 elements
						// needs a scratch buffer to reverse them first. Not yet implemented.
						System.error("compile error", "tier1->Wasm: CREATE_LIST with >9 elements unsupported");
					}
				}
				CREATE_FUNC => {
					def funchole = ciceroBytecode.funcPool[operand];
					var nonlocalCount = funchole.nonlocals.length;
					for (i < funchole.nonlocals.length) {
						if (Strings.equal(funchole.nonlocals[i], funchole.id)) nonlocalCount--;
					}
					if (nonlocalCount <= 9) {
						// nonlocal values are already on the stack (forward order, last
						// pushed on top), but createFuncN needs the funchole index FIRST.
						// Buffer them through argScratch to reinsert the index underneath.
						for (i = nonlocalCount - 1; i >= 0; i--) {
							wasm.putb(WasmOp.SET_LOCAL.opcode);
							wasm.put_uleb32(argScratch[i]);
						}
						wasm.putb(WasmOp.I32_CONST.opcode);
						wasm.put_sleb32(operand);
						for (i < nonlocalCount) {
							wasm.putb(WasmOp.GET_LOCAL.opcode);
							wasm.put_uleb32(argScratch[i]);
						}
						match (nonlocalCount) {
							0 => emitCall(CREATE_FUNC0);
							1 => emitCall(CREATE_FUNC1);
							2 => emitCall(CREATE_FUNC2);
							3 => emitCall(CREATE_FUNC3);
							4 => emitCall(CREATE_FUNC4);
							5 => emitCall(CREATE_FUNC5);
							6 => emitCall(CREATE_FUNC6);
							7 => emitCall(CREATE_FUNC7);
							8 => emitCall(CREATE_FUNC8);
							9 => emitCall(CREATE_FUNC9);
						}
					} else {
						// same xargs-ordering complication as CREATE_LIST/CALL's >9 cases
						System.error("compile error", "tier1->Wasm: CREATE_FUNC with >9 nonlocals unsupported");
					}
				}
				POP => {
					for (i < operand) wasm.putb(WasmOp.DROP.opcode);
				}
				DUPE => {
					// only depths 0 (VarSet) and 1 (SetField) are ever emitted by BytecodeCompiler
					match (operand) {
						0 => wasmDup();
						1 => {
							// [..., a, b] -> [..., a, b, a]
							wasm.putb(WasmOp.SET_LOCAL.opcode);
							wasm.put_uleb32(scratch0); // pop b; [..., a]
							wasm.putb(WasmOp.SET_LOCAL.opcode);
							wasm.put_uleb32(scratch1); // pop a; [...]
							wasm.putb(WasmOp.GET_LOCAL.opcode);
							wasm.put_uleb32(scratch1); // [..., a]
							wasm.putb(WasmOp.GET_LOCAL.opcode);
							wasm.put_uleb32(scratch0); // [..., a, b]
							wasm.putb(WasmOp.GET_LOCAL.opcode);
							wasm.put_uleb32(scratch1); // [..., a, b, a]
						}
						_ => System.error("compile error", "tier1->Wasm: DUPE at unsupported depth");
					}
				}
				SWAP => {
					// only depth 1 (SetField) is ever emitted by BytecodeCompiler
					match (operand) {
						1 => wasmSwap();
						_ => System.error("compile error", "tier1->Wasm: SWAP at unsupported depth");
					}
				}
				RETURN => /* no implementation */ ;
			}

			pc += 4;
		}
	}
	
	def handlerStack: Stack<int> = ArrayStack.new();
	var blockDepth = 0;

	def compile() -> WasmBytecode {
		/* TODO We will have to figure out all the locals that will be in the function. 
		 * Some of them are locals because they are parameters. Like the BytecodeCompiler
		 * there should be an argument for these locals, which end up getting handled in
		 * the same way as Wasm arguments (they become the first locals). 
		 *
		 * From running the compile process `locals` will have the full set of locals
		 * and the map from indices to names. However, this also includes the parameters,
		 * so we will have to take a slice after the parameters, so we only have bona-fide
		 * locals to work with.
		 *
		 * Those bona-fide locals will be emitted as part of the code's locals declaration.
		 */
		def wasm = wasm.extract();

		if (CiceroOptions.traceWasmCompilation) {
			System.puts(Strings.format1("--- raw bytes (%d) ---\n", wasm.length));
			def sb = StringBuilder.new();
			for (i < wasm.length) {
				sb.putx(int.!(wasm[i]));
				sb.putc(' ');
				if ((i & 15) == 15) sb.ln();
			}
			sb.ln();
			System.puts(sb.extract());
			System.puts("---\n");
		}

		var sig: int;
		match (params.length) {
			0 => sig = CiWasmTarget.functionTypeId<int, bool>();
			1 => sig = CiWasmTarget.functionTypeId<(int, int), bool>();
			2 => sig = CiWasmTarget.functionTypeId<(int, int, int), bool>();
			3 => sig = CiWasmTarget.functionTypeId<(int, int, int, int), bool>();
			4 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int), bool>();
			5 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int), bool>();
			6 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int, int), bool>();
			7 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int, int, int), bool>();
			8 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int, int, int, int), bool>();
			9 => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int, int, int, int, int), bool>();
			_ => sig = CiWasmTarget.functionTypeId<(int, int, int, int, int, int, int, int, int, int), bool>();
		}
		def fid  = wave.new_func(sig, Pointer.atContents(wasm), wasm.length);
		if (fid < 0) {
			System.puts("failed validation, terminating\n");
			System.error("failed validation", "generated function failed validation");
		}
		var func: WasmFunction;
		match (params.length) {
			0 => func = WasmFunction.Func0(CiRuntime.forgeClosure<void, void, bool>(Pointer.NULL + fid, void));	
			1 => func = WasmFunction.Func1(CiRuntime.forgeClosure<void, int, bool>(Pointer.NULL + fid, void));
			2 => func = WasmFunction.Func2(CiRuntime.forgeClosure<void, (int, int), bool>(Pointer.NULL + fid, void));
			3 => func = WasmFunction.Func3(CiRuntime.forgeClosure<void, (int, int, int), bool>(Pointer.NULL + fid, void));
			4 => func = WasmFunction.Func4(CiRuntime.forgeClosure<void, (int, int, int, int), bool>(Pointer.NULL + fid, void));
			5 => func = WasmFunction.Func5(CiRuntime.forgeClosure<void, (int, int, int, int, int), bool>(Pointer.NULL + fid, void));
			6 => func = WasmFunction.Func6(CiRuntime.forgeClosure<void, (int, int, int, int, int, int), bool>(Pointer.NULL + fid, void));
			7 => func = WasmFunction.Func7(CiRuntime.forgeClosure<void, (int, int, int, int, int, int, int), bool>(Pointer.NULL + fid, void));
			8 => func = WasmFunction.Func8(CiRuntime.forgeClosure<void, (int, int, int, int, int, int, int, int), bool>(Pointer.NULL + fid, void));
			9 => func = WasmFunction.Func9(CiRuntime.forgeClosure<void, (int, int, int, int, int, int, int, int, int), bool>(Pointer.NULL + fid, void));
			_ => func = WasmFunction.FuncN(CiRuntime.forgeClosure<void, (int, int, int, int, int, int, int, int, int), bool>(Pointer.NULL + fid, void));
		}
		return WasmBytecode.new(
				func,
				locals.extract(), 
				nonlocals.extract(),
				strings.extract(), 
				consts.extract(), 
				classholes.extract(), 
				funcholes.extract()
				);
	}

	def emitPushConst(val: Object) {
		wasm.putb(WasmOp.I32_CONST.opcode);
		wasm.put_sleb32(addConst(val));
	}

	def emitPushString(str: string) {
		wasm.putb(WasmOp.I32_CONST.opcode);
		wasm.put_sleb32(addString(str));
	}

	// assert field present in object
	def emitAssertField(field: string) {
		emitCall(IS_NULL);
		withIf<int, int>(fun {
			wasm.putb(WasmOp.DROP.opcode);
			wasm.putb(WasmOp.GET_LOCAL.opcode);
			wasm.put_uleb32(scratch1);
			emitPushString(field);
			emitCall(RAISE_FIELD);
			emitJumpToExnHandler();
		});
	}

	def emitRaiseIfNull(exn: string) {
		wasmDup();
		emitCall(IS_NULL);
		withIf<int, int>(fun {
			emitPushConst(ExnObjects.fromWasm(exn));
			emitJumpToExnHandler();
		});
	}

	// For the bytecode/relooper path: assumes a value is already on top of the
	// stack. Turns [value] into [value, 1] if non-null, or [exn, 0] if null,
	// matching the convention relooper's If expects (1 = no exception / take
	// fallthrough, 0 = exception / take branch). The non-null case is the hot
	// path: it costs nothing beyond the check itself, since the param passes
	// straight through an empty true-arm; exception construction only runs on
	// the (rare) null arm.
	def emitNullGuard(exn: string) {
		wasmDup();
		emitCall(IS_NOT_NULL);
		wasm.putb(WasmOp.TEE_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // stash flag, leave on stack; [value, flag]
		withIfElse<int, int>(fun {
			// hot path: non-null, param passes through unchanged
		}, /* else */ fun {
			wasm.putb(WasmOp.DROP.opcode);
			emitPushConst(ExnObjects.fromWasm(exn));
		});
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // [resultValue, flag]
	}

	// Same shape as emitNullGuard, but for guards whose exception depends on a
	// runtime value (the field's object) rather than a precomputable constant.
	// Assumes the caller already stashed that object in scratch1 (e.g. via
	// TEE_LOCAL before GET_FIELD/SET_FIELD).
	def emitFieldGuard(field: string) {
		wasmDup();
		emitCall(IS_NOT_NULL);
		wasm.putb(WasmOp.TEE_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // stash flag, leave on stack; [value, flag]
		withIfElse<int, int>(fun {
			// hot path: field present, param passes through unchanged
		}, /* else */ fun {
			wasm.putb(WasmOp.DROP.opcode);
			wasm.putb(WasmOp.GET_LOCAL.opcode);
			wasm.put_uleb32(scratch1);          // reload the object stashed by the caller
			emitPushString(field);
			emitCall(RAISE_FIELD);              // dynamically builds the real exn from obj+field
		});
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // [resultValue, flag]
	}

	// For guards whose exception is signaled by the preceding RTS call's own
	// bool return (true = exception), not a null check on the value itself
	// (CALL, CREATE_OBJECT, CREATE_CLASS). Assumes that bool is on top of the
	// stack already. The call always runs regardless of outcome, so there's
	// no hot/cold split to exploit here - just reorder and invert.
	def emitResultGuard() {
		// stack: [exceptionBool]
		emitCall(GET_RESULT);
		wasmSwap();                              // [resultValue, exceptionBool]
		wasm.putb(WasmOp.I32_EQZ.opcode);        // [resultValue, flag]  (invert: exceptionBool=1 -> flag=0, and vice versa)
	}

	// For the bytecode/relooper path: like emitNullGuard, but the check is a
	// type test (checkFn returns true when the value IS the expected type,
	// matching our flag convention directly - no inversion needed) and the
	// exn is built from the bad value itself via RAISE_TYPE. No DROP needed
	// in the cold arm: the still-present param IS RAISE_TYPE's first argument,
	// not something being discarded and replaced.
	def emitTypeGuard(checkFn: u32, expectedClass: Object) {
		wasmDup();
		emitCall(checkFn);
		wasm.putb(WasmOp.TEE_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // stash flag, leave on stack; [value, flag]
		withIfElse<int, int>(fun {
			// hot path: correct type, param passes through unchanged
		}, /* else */ fun {
			emitPushConst(expectedClass);        // [value, expectedClassIdx]
			emitCall(RAISE_TYPE);                // [exnObj]
		});
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);              // [resultValue, flag]
	}

	// CREATE_OBJECT/CREATE_CLASS: a type check that, unlike emitTypeGuard,
	// must skip the RTS call entirely on failure rather than always proceeding
	// - calling rtsFn on a non-class value would be a hard Virgil cast failure,
	// not a graceful Cicero exception. Both arms must agree on a single-value
	// block type, so the flag (which differs in shape: a fixed 0 on the cold
	// arm vs. emitResultGuard's computed value on the hot arm) is stashed into
	// scratch1 as a side effect inside each arm rather than carried as part of
	// the block's own result - avoids needing a multi-value (tuple) block type.
	def emitGuardedCall(checkFn: u32, expectedClass: Object, pushExtraArgs: void -> void, rtsFn: u32) {
		wasmDup();
		emitCall(checkFn);
		withIfElse<int, int>(fun {
			pushExtraArgs();
			emitCall(rtsFn);
			emitResultGuard();                   // [resultValue, flag]
			wasm.putb(WasmOp.SET_LOCAL.opcode);
			wasm.put_uleb32(scratch1);            // [resultValue]
		}, /* else */ fun {
			emitPushConst(expectedClass);
			emitCall(RAISE_TYPE);                 // [exnObj]
			wasm.putb(WasmOp.I32_CONST.opcode);
			wasm.putb(0);
			wasm.putb(WasmOp.SET_LOCAL.opcode);
			wasm.put_uleb32(scratch1);            // [exnObj]
		});
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch1);                // [resultValue, flag]
	}

	def emitAssertType(isFunc: u32, expectedClass: Object) {
		wasmDup();
		emitCall(isFunc);
		withIfFalse<int, int>(fun {
			emitPushConst(expectedClass);
			emitCall(RAISE_TYPE);
			emitJumpToExnHandler();
		});
	}

	def emitInterpretResult() {
		withIfElse<void, int>(fun {
			emitCall(GET_RESULT);
			emitJumpToExnHandler();
		}, /* else */ fun {
			emitCall(GET_RESULT);
		});
	}

	def emitJumpToExnHandler() {
		wasm.putb(WasmOp.BR.opcode);
		wasm.put_sleb32(blockDepth - handlerStack.peek());
	}

	def emitCall(funcId: u32) {
		wasm.putb(WasmOp.CALL.opcode);
		wasm.put_uleb32(funcId);
	}

	def wasmDup() {
		wasm.putb(WasmOp.TEE_LOCAL.opcode);
		wasm.put_uleb32(scratch0);
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);
	}

	def wasmSwap() {
		wasm.putb(WasmOp.SET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);
		wasm.putb(WasmOp.SET_LOCAL.opcode);
		wasm.put_uleb32(scratch1);
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch0);
		wasm.putb(WasmOp.GET_LOCAL.opcode);
		wasm.put_uleb32(scratch1);
	}

	def withControl<I, O>(emit: void -> void, opcode: WasmOp) {
		def blockSig = CiWasmTarget.functionTypeId<I, O>();
		wasm.putb(opcode.opcode);
		wasm.put_sleb32(blockSig);
		blockDepth++;
			emit();
		wasm.putb(WasmOp.END.opcode);
		blockDepth--;
	}
	def withIf<I, O>(emit: void -> void) {
		withControl<I, O>(emit, WasmOp.IF);
	}
	def withIfElse<I, O>(emitTrue: void -> void, emitFalse: void -> void) {
		withIf<I, O>(fun {
			emitTrue();
			wasm.putb(WasmOp.ELSE.opcode);
			emitFalse();
		});
	}
	def withIfFalse<I, O>(emitFalse: void -> void) {
		withIfElse<I, O>(fun {}, emitFalse);
	}
	def withBlock<I, O>(emit: void -> void) {
		withControl<I, O>(emit, WasmOp.BLOCK);
	}
	def withLoop<I, O>(emit: void -> void) {
		withControl<I, O>(emit, WasmOp.LOOP);
	}
	
	def compileAST(expr: AST) {
		match (expr.data) {
			Lit(lit) => {
				emitPushConst(lit);
			}
  			VarGet(id, mode) => match (mode.data) {
  				Local    => {
 					wasm.putb(WasmOp.GET_LOCAL.opcode);
 					wasm.put_uleb32(addLocal(id));

					emitRaiseIfNull(Exceptions.unboundLocal(id));
 				}
  				Global => {
					emitPushString(id);
 					emitCall(GET_GLOBAL);

					emitRaiseIfNull(Exceptions.unboundGlobal(id));
				}
  				Nonlocal => {
					emitPushString(id);
 					emitCall(GET_NONLOCAL);
				}
			}
 			VarSet(id, mode, val) => match (mode.data) {
 				Local => {
					compileAST(val);
 					wasm.putb(WasmOp.TEE_LOCAL.opcode);
 					wasm.put_uleb32(addLocal(id));
 				}
 				Global => {
					emitPushString(id);
					compileAST(val);
 					emitCall(SET_GLOBAL);
				}
 				Nonlocal => System.error("compile error", "illegal case on varset: Nonlocal");
 			}
 			And(left, right) => {
 				compileAST(left);
				wasmDup();

				emitCall(IS_TRUE);

				withIf<int, int>(fun {
					wasm.putb(WasmOp.DROP.opcode);
					compileAST(right);
				});
 			}
 			Or(left, right) => {
				compileAST(left);
				wasmDup();

				emitCall(IS_FALSE);

				withIf<int, int>(fun {
					wasm.putb(WasmOp.DROP.opcode);
					compileAST(right);
				});
 			}
 			Apply(tgt, args) => {
				compileAST(tgt);
				emitAssertType(IS_FUNC, ClassObjects.classFunc);

				if (args.length <= 9) {
					for (arg in args)
						compileAST(arg);
					// dispatch on number of args to variadic function
					wasm.putb(WasmOp.CALL.opcode);
					match (args.length) {
						0 => wasm.put_uleb32(CALL_FUNC0);  /* call to RTS */
						1 => wasm.put_uleb32(CALL_FUNC1);  /* call to RTS */
						2 => wasm.put_uleb32(CALL_FUNC2);  /* call to RTS */
						3 => wasm.put_uleb32(CALL_FUNC3);  /* call to RTS */
						4 => wasm.put_uleb32(CALL_FUNC4);  /* call to RTS */
						5 => wasm.put_uleb32(CALL_FUNC5);  /* call to RTS */
						6 => wasm.put_uleb32(CALL_FUNC6);  /* call to RTS */
						7 => wasm.put_uleb32(CALL_FUNC7);  /* call to RTS */
						8 => wasm.put_uleb32(CALL_FUNC8);  /* call to RTS */
						9 => wasm.put_uleb32(CALL_FUNC9);  /* call to RTS */
					}
				} else {
					// top 9 are on Wasm's stack, rest are in a virtual stack holding the rest
					for (i < 9)
						compileAST(args[i]);
					for (i = 9; i < args.length; i++) {
						compileAST(args[i]);
						emitCall(PUSH_ARG);
					}
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(args.length - 9); // number of extra args
					emitCall(CALL_FUNC_REST);
				}

				// if exception, find handler
				emitInterpretResult();
			}
 			If(cond, left, right) => {
				compileAST(cond);
				emitCall(IS_TRUE);
				withIfElse<void, int>(fun {
					compileAST(left);
				}, /* else */ fun {
					compileAST(right);
				});
			}
			Cond(cases) => {
				withBlock<void, int>(fun {
					for (c in cases) {
						def cond = c.0;
						def body = c.1;
						withBlock<void, int>(fun {
							compileAST(cond);
							
							wasmDup();
							emitCall(IS_FALSE);

							wasm.putb(WasmOp.BR_IF.opcode);
							wasm.put_uleb32(0); // next case
							compileAST(body);
							wasm.putb(WasmOp.BR.opcode);
							wasm.put_uleb32(1); // done
						});
					}

					// throw exception
					emitPushConst(ExnObjects.fromWasm(Exceptions.noTrueBranch));
					emitJumpToExnHandler();
				});
			}
			Raise(exn) => {
				compileAST(exn);
				emitAssertType(IS_STRING, ClassObjects.classStr); // TODO don't realloc const slot

				emitCall(RAISE_STRING);
				emitJumpToExnHandler();
			}
 			Catch(try, id, mode, catch) => {
				withBlock<void, int>(fun {
					withBlock<void, int>(fun {

						handlerStack.push(blockDepth);

						compileAST(try);
						wasm.putb(WasmOp.BR.opcode);
						wasm.put_uleb32(1); // ok

						handlerStack.pop();
					});

					match (mode.data) {
						Local => {
							wasm.putb(WasmOp.SET_LOCAL.opcode);
							wasm.put_uleb32(addLocal(id));
						}
						Global => {
							wasm.putb(WasmOp.SET_LOCAL.opcode);
							wasm.put_uleb32(scratch0);
							emitPushString(id);
							wasm.putb(WasmOp.GET_LOCAL.opcode);
							wasm.put_uleb32(scratch0);
							emitCall(SET_GLOBAL);
							wasm.putb(WasmOp.DROP.opcode);
						}
						Nonlocal => System.error("compile error", "illegal case on catch: Nonlocal");
					}
					compileAST(catch);
				});
			}
			Func(id, params, body, nonlocals) => {
 				body.compile(params);

				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.put_sleb32(addFunchole(ASTData.Func.!(expr.data)));
 			
				var nonlocalCount = 0;
 				for (i < nonlocals.length) {
 					def nonlocal = nonlocals[i];
 					if (Strings.equal(nonlocal, id))
 						// the function itself is captured, but not loaded to a local
 						continue;
 					// this variable will be captured!
 					wasm.putb(WasmOp.GET_LOCAL.opcode);
 					wasm.put_uleb32(addLocal(nonlocal));
					emitRaiseIfNull(Exceptions.unboundLocal(nonlocal));
					nonlocalCount++;
					if (nonlocalCount > 9) emitCall(PUSH_ARG);
 				}

				match (nonlocalCount) {
					0 => emitCall(CREATE_FUNC0);  /* call to RTS */
					1 => emitCall(CREATE_FUNC1);  /* call to RTS */
					2 => emitCall(CREATE_FUNC2);  /* call to RTS */
					3 => emitCall(CREATE_FUNC3);  /* call to RTS */
					4 => emitCall(CREATE_FUNC4);  /* call to RTS */
					5 => emitCall(CREATE_FUNC5);  /* call to RTS */
					6 => emitCall(CREATE_FUNC6);  /* call to RTS */
					7 => emitCall(CREATE_FUNC7);  /* call to RTS */
					8 => emitCall(CREATE_FUNC8);  /* call to RTS */
					9 => emitCall(CREATE_FUNC9);  /* call to RTS */
					_ => {
						wasm.putb(WasmOp.I32_CONST.opcode);
						wasm.put_sleb32(nonlocalCount - 9); // number of extra args
						emitCall(CREATE_FUNC_REST);
					}
				}
 			}
 			While(cond, body) => {
				withBlock<void, int>(fun {
					withLoop<void, int>(fun {
						compileAST(cond);
						wasmDup();
						emitCall(IS_FALSE);
						wasm.putb(WasmOp.BR_IF.opcode);
						wasm.put_uleb32(1); // exit loop

						compileAST(body);
						wasm.putb(WasmOp.BR.opcode);
						wasm.put_uleb32(0); // back to top of loop
					});
				});
			}
 			Begin(exprs) => {
				for (i < exprs.length - 1) {
					compileAST(exprs[i]);
 					wasm.putb(WasmOp.DROP.opcode);
				}
				compileAST(exprs[exprs.length - 1]);
				
			}
 			GetField(field, obj) => {
				compileAST(obj);
				
				wasm.putb(WasmOp.TEE_LOCAL.opcode);
				wasm.put_uleb32(scratch1); // stash object
				emitPushString(field);
				emitCall(GET_FIELD);
				wasmDup();

				emitAssertField(field);
			}
 			SetField(field, obj, val) => {
				compileAST(obj);
				wasm.putb(WasmOp.TEE_LOCAL.opcode);
				wasm.put_uleb32(scratch1); // stash object

				emitPushString(field);
				compileAST(val);
				emitCall(SET_FIELD);
				wasmDup();
				
				emitAssertField(field);
			}
 			Class(id, superclass, init, fields, methods) => {
				// there are subcodes which are getting compiled here
				match (superclass) {
					Nothing => {
						emitPushConst(ClassObjects.classBase);
					}
					Just(expr) => compileAST(expr);
				}
				var init2: CodeObject;
				match (init) {
					Nothing => ;
					Just(code) => {
						code.compile(["self"]);
						init2 = code;
					}
				}
				for (field in fields) field.1.compile([]);
				def classhole = ClassObjects.classhole(id, init2, fields, Arrays.map(methods, funcToFunc));

				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.put_sleb32(addClasshole(classhole));

				emitCall(CREATE_CLASS);

				// if exception, find handler
				emitInterpretResult();
			}
 			New(expr) => {
 				compileAST(expr);
				
				emitAssertType(IS_CLASS, ClassObjects.classClass);

 				emitCall(CREATE_OBJECT);

				// if exception, find handler
				emitInterpretResult();
			}
 			List(elems) => {
				if (elems.length <= 9) {
					for (elem in elems)
						compileAST(elem);
					wasm.putb(WasmOp.CALL.opcode);
					match (elems.length) {
						0 => wasm.put_uleb32(CREATE_LIST0);
						1 => wasm.put_uleb32(CREATE_LIST1);
						2 => wasm.put_uleb32(CREATE_LIST2);
						3 => wasm.put_uleb32(CREATE_LIST3);
						4 => wasm.put_uleb32(CREATE_LIST4);
						5 => wasm.put_uleb32(CREATE_LIST5);
						6 => wasm.put_uleb32(CREATE_LIST6);
						7 => wasm.put_uleb32(CREATE_LIST7);
						8 => wasm.put_uleb32(CREATE_LIST8);
						9 => wasm.put_uleb32(CREATE_LIST9);
					}
				} else {
					for (i = 0; i < elems.length; i++) {
						compileAST(elems[i]);
						if (i >= 9) emitCall(PUSH_ARG); // extra args in runtime
					}
					wasm.putb(WasmOp.I32_CONST.opcode);
					wasm.put_sleb32(elems.length - 9); // number of extra args
					emitCall(CREATE_LIST_REST);
				}
			}
			Return(expr) => {
				compileAST(expr);
				emitCall(SET_RESULT);
				wasm.putb(WasmOp.I32_CONST.opcode);
				wasm.putb(0); // OK
				wasm.putb(WasmOp.RETURN.opcode);
			}
		}
	}

	// from BytecodeCompiler
	def addLocal(id: string) -> u32 {
		for (i < locals.length) {
			if (Strings.equal(locals[i], id))
				return u32.view(i);
		}
		def idx = locals.length;
		locals.put(id);
		return u32.view(idx);
	}

	def addConst(const: Object) -> int {
		def idx = consts.length;
		consts.put(const);
		return idx;
	}

	def addString(str: string) -> int {
		// check for existing string
		for (i = 0; i < strings.length; i++) {
			if (Strings.equal(strings[i], str))
				return i;
		}
		def idx = strings.length;
		strings.put(str);
		return idx;
	}

	def addClasshole(clazz: ClassObject -> ClassObject) -> int {
		def idx = classholes.length;
		classholes.put(clazz);
		return idx;
	}

	def addFunchole(func: ASTData.Func) -> int {
		def idx = funcholes.length;
		funcholes.put(func);
		return idx;
	}


	def compileBytecode() {
		
	}
}

def ptrAt(o: Object) -> i32 {
	return Pointer.atObject(o) - Pointer.NULL;
}
def ptrAtBox<T>(b: Box<T>) -> i32 {
	return Pointer.atObject(b) - Pointer.NULL;
}
def ptrAtStr(o: string) -> i32 {
	return Pointer.atObject(o) - Pointer.NULL;
}

def funcToFunc(f: ASTData.Func) -> FuncObject {
	// XXX compilation here
	f.body.compile(Arrays.prepend("self", f.params));
	// XXX empty map = no variable capture for a method
	return FuncObjects.newFO(f.id, f.params, [], f.body);
}

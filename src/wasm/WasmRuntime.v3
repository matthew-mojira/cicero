/* The runtime is the target of Wasm-level indirections for the GC */
def traceRuntime = true;

component WasmRuntime {
	/* this are not stacks, since Frame will be responsible for
	 * restoring this state
	 */
	var frame: WasmFrame;
	var strings: Array<string>;
	var funcholes: Array<ASTData.Func>;
	var classholes: Array<ClassObject -> ClassObject>;
	var objects: Vector<Object>;
	var refcounts: Vector<int>;                        // parallel to objects
	var freelist: ArrayStack<int> = ArrayStack.new();   // reusable objects[] indices
	var constPoolLen: int;                              // objects[0 .. constPoolLen) exempt from refcounting
	var constsPtr: Array<Object>;                       // shadow-stack mode: this frame's own const pool, for LOAD_CONST
	var result: int;
	var xargs: ArrayStack<int> = ArrayStack.new(); // ArrayStack so `.top` gives a depth mark for reentrant calls

	def pushArg(idx: int) => xargs.push(idx);
	def popArg() -> int => xargs.pop();

	// Shadow-stack mode's equivalent of xargs: a plain ArrayStack<int> can't
	// hold raw pointers safely (a relocating collection triggered by anything
	// pushed/popped around it wouldn't know to update entries sitting in an
	// int array), so this holds real, GC-scanned Objects instead - converted
	// at the boundary (pushArgPtr/popArgPtr), mirroring every other *Ptr
	// host function's "convert immediately, before anything can allocate"
	// pattern.
	var xargsObjs: ArrayStack<Object> = ArrayStack.new();

	def pushArgPtr(ptr: int) => xargsObjs.push(ptrToObj(ptr));
	def popArgPtr() -> int => objToPtr(xargsObjs.pop());

	def incref(idx: int) {
		if (idx == 0 || idx < constPoolLen) return;
		refcounts[idx] = refcounts[idx] + 1;
	}
	def decref(idx: int) {
		if (!CiceroOptions.useRefcounting) return;
		if (idx == 0 || idx < constPoolLen) return;
		if (CiceroOptions.sanityChecks && refcounts[idx] <= 0)
			System.error("internal error", "WasmRuntime.decref underflow");
		refcounts[idx] = refcounts[idx] - 1;
		if (refcounts[idx] == 0) {
			objects[idx] = null; // let Virgil's own GC reclaim it
			freelist.push(idx);
		}
	}

	/* assume null object = 0 in objects */

	def isNull(idx: int) -> bool {
		return objects[idx] == null; /* XXX should also be idx == 0 */
	}
	def isNotNull(idx: int) -> bool {
		return objects[idx] != null;
	}
	def isTrue(idx: int)  -> bool => objects[idx].isTrue();
	def isFalse(idx: int) -> bool => !objects[idx].isTrue();
	def isFunc(idx: int)  -> bool => objects[idx].instanceOf(ClassObjects.classFunc);
	def isClass(idx: int) -> bool => objects[idx].instanceOf(ClassObjects.classClass);
	def isString(idx: int)-> bool => objects[idx].instanceOf(ClassObjects.classStr);

	def getGlobal(idx: int) -> int {
		def id = strings[idx];
		def obj = frame.getGlobal(id);
		return alloc(obj);
	}
	def getGlobalByIndex(idx: int) -> int {
		return alloc(Globals.loadGlobalByIndex(idx));
	}

	def getNonlocal(idx: int) -> int {
		def id = strings[idx];
		def obj = frame.getNonlocal(id);
		return alloc(obj);
	}

	def setGlobal(strIdx: int, objIdx: int) -> int {
		def obj = objects[objIdx];
		def id = strings[strIdx];
		frame.setGlobal(id, obj);
		return objIdx;
	}
	def setGlobalByIndex(idx: int, objIdx: int) -> int {
		Globals.storeGlobalByIndex(idx, objects[objIdx]);
		return objIdx;
	}

	def raiseTypeException(actIdx: int, expIdx: int) -> int {
		def act = objects[actIdx];
		def exp = objects[expIdx];
		def msg = Exceptions.typeMismatch(ClassObject.!(exp), act);
		def exn = ExnObjects.fromWasm(msg);
		decref(actIdx);
		decref(expIdx);
		return alloc(exn);
	}
	def raiseString(strIdx: int) -> int {
		def str = objects[strIdx];
		def exn = ExnObjects.fromWasm(StrObject.!(str).str);
		decref(strIdx);
		return alloc(exn);
	}
	def raiseMissingField(objIdx: int, strIdx: int) -> int {
		def obj = objects[objIdx];
		def str = strings[strIdx];
		def msg = Exceptions.missingField(obj, str);
		def exn = ExnObjects.fromWasm(msg);
		decref(objIdx);
		return alloc(exn);
	}

	def pushFrame();
	def popFrame();

	/* Calls to other functions */
	/* TODO make compiler inline these functions */
	def callFunc0(func: int) => callFuncN(func, []);
	def callFunc1(func: int, o0: int) => callFuncN(func, [o0]);
	def callFunc2(func: int, o0: int, o1: int) => callFuncN(func, [o0, o1]);
	def callFunc3(func: int, o0: int, o1: int, o2: int) => callFuncN(func, [o0, o1, o2]);
	def callFunc4(func: int, o0: int, o1: int, o2: int, o3: int) => callFuncN(func, [o0, o1, o2, o3]);
	def callFunc5(func: int, o0: int, o1: int, o2: int, o3: int, o4: int) => callFuncN(func, [o0, o1, o2, o3, o4]);
	def callFunc6(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) => callFuncN(func, [o0, o1, o2, o3, o4, o5]);
	def callFunc7(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) => callFuncN(func, [o0, o1, o2, o3, o4, o5, o6]);
	def callFunc8(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) => callFuncN(func, [o0, o1, o2, o3, o4, o5, o6, o7]);
	def callFunc9(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) => callFuncN(func, [o0, o1, o2, o3, o4, o5, o6, o7, o8]);
	def callFuncRest(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> bool {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0;
		args[1] = o1;
		args[2] = o2;
		args[3] = o3;
		args[4] = o4;
		args[5] = o5;
		args[6] = o6;
		args[7] = o7;
		args[8] = o8;
		popRestReverse(args, numRest);
		return callFuncN(func, args);
	}

	// Fill args[9 ..] from xargs for the bytecode (tier-1-derived) tier. Unlike the
	// AST tier — which PUSH_ARGs each extra as it is produced, so xargs holds them
	// left-to-right (pop in reverse) — the bytecode tier has every operand already
	// on the Wasm stack and PUSH_ARGs the tail rightmost-first, so xargs holds the
	// extras in reverse. Pop them forward to restore left-to-right order. The
	// callFuncRestRev/createListRestRev/createFuncRestRev entries below mirror their
	// non-Rev counterparts but drain xargs this way.
	//
	// baseDepth, not empty(): xargs is shared across reentrant calls (a >9-arg
	// call can be nested in another's rest-args), so an outer call's items may
	// still be under ours.
	def popRestForward(args: Array<int>, numRest: int) {
		def baseDepth = xargs.top - numRest;
		for (i < numRest) {
			if (CiceroOptions.sanityChecks && xargs.top <= baseDepth) {
				System.puts("internal error: WasmRuntime.xargs underflowed this call's own arguments\n");
				System.error("internal error", "WasmRuntime.xargs underflowed this call's own arguments");
			}
			args[9 + i] = xargs.pop();
		}
		if (CiceroOptions.sanityChecks && xargs.top != baseDepth) {
			System.puts("internal error: WasmRuntime.xargs did not return to its pre-call depth\n");
			System.error("internal error", "WasmRuntime.xargs did not return to its pre-call depth");
		}
	}

	// Like popRestForward but pops in reverse, for the AST tier's callFuncRest/createFuncRest/createListRest.
	def popRestReverse(args: Array<int>, numRest: int) {
		def baseDepth = xargs.top - numRest;
		for (i = numRest - 1; i >= 0; i--) {
			if (CiceroOptions.sanityChecks && xargs.top <= baseDepth) {
				System.puts("internal error: WasmRuntime.xargs underflowed this call's own arguments\n");
				System.error("internal error", "WasmRuntime.xargs underflowed this call's own arguments");
			}
			args[9 + i] = xargs.pop();
		}
		if (CiceroOptions.sanityChecks && xargs.top != baseDepth) {
			System.puts("internal error: WasmRuntime.xargs did not return to its pre-call depth\n");
			System.error("internal error", "WasmRuntime.xargs did not return to its pre-call depth");
		}
	}

	// xargsObjs equivalents of popRestForward/popRestReverse, for shadow-stack
	// mode's callFuncRestPtr/createFuncRestPtr/createListRestPtr families.
	def popRestForwardObjs(args: Array<Object>, numRest: int) {
		def baseDepth = xargsObjs.top - numRest;
		for (i < numRest) {
			if (CiceroOptions.sanityChecks && xargsObjs.top <= baseDepth) {
				System.puts("internal error: WasmRuntime.xargsObjs underflowed this call's own arguments\n");
				System.error("internal error", "WasmRuntime.xargsObjs underflowed this call's own arguments");
			}
			args[9 + i] = xargsObjs.pop();
		}
		if (CiceroOptions.sanityChecks && xargsObjs.top != baseDepth) {
			System.puts("internal error: WasmRuntime.xargsObjs did not return to its pre-call depth\n");
			System.error("internal error", "WasmRuntime.xargsObjs did not return to its pre-call depth");
		}
	}
	def popRestReverseObjs(args: Array<Object>, numRest: int) {
		def baseDepth = xargsObjs.top - numRest;
		for (i = numRest - 1; i >= 0; i--) {
			if (CiceroOptions.sanityChecks && xargsObjs.top <= baseDepth) {
				System.puts("internal error: WasmRuntime.xargsObjs underflowed this call's own arguments\n");
				System.error("internal error", "WasmRuntime.xargsObjs underflowed this call's own arguments");
			}
			args[9 + i] = xargsObjs.pop();
		}
		if (CiceroOptions.sanityChecks && xargsObjs.top != baseDepth) {
			System.puts("internal error: WasmRuntime.xargsObjs did not return to its pre-call depth\n");
			System.error("internal error", "WasmRuntime.xargsObjs did not return to its pre-call depth");
		}
	}

	def callFuncRestRev(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> bool {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0; args[1] = o1; args[2] = o2; args[3] = o3; args[4] = o4;
		args[5] = o5; args[6] = o6; args[7] = o7; args[8] = o8;
		popRestForward(args, numRest);
		return callFuncN(func, args);
	}

	def callFuncN(fvIdx: int, args: Array<int>) -> bool { /* returns if exception */
		def fv = FuncObject.!(objects[fvIdx]);
		def params = fv.params, code = fv.code;

		// evaluate argument values
		var argv: Array<(string, Object)>;

		if (fv.instanceOf(ClassObjects.classMethod)) {
			argv = Array.new(args.length + 1);
			for (i < args.length) {
				def arg = args[i];
				if (i < params.length) // avoid out of bounds but don't raise exception
					argv[i + 1] = (params[i], objects[arg]);
			}
			argv[0] = ("self", MethodObject.!(fv).obj);
		} else {
			argv = Array.new(args.length);
			for (i < args.length) {
				def arg = args[i];
				if (i < params.length) // avoid out of bounds but don't raise exception
					argv[i] = (params[i], objects[arg]);
			}
		}

		decref(fvIdx);
		for (i < args.length) decref(args[i]);

		if (args.length != params.length) {
			def obj = ExnObjects.fromWasm(Exceptions.arityMismatch(params.length, args.length));
			result = alloc(obj);
			return true;
		}

		match (invokeCode(code, argv, fv.nonlocals)) {
			OK(v) => {
				result = alloc(v);
				return false;
			}
			Exn(e) => {
				result = alloc(e);
				return true;
			}
			_ => {
				System.error("internal error", "evaluation of frame returned uncomputed");
				return false;
			}
		}
	}

	// A Wasm-tier call target is always Wasm-compiled or a Virgil builtin.
	def invokeCode(code: CodeObject, argv: Array<(string, Object)>, nonlocals: Array<(string, Object)>) -> Result {
		match (code.code) {
			Virgil(fn) => return fn(Arrays.map(argv, fun(p: (string, Object)) => p.1));
			Wasm => {
				def f = WasmFrame.new(code, argv, nonlocals);
				f.eval();
				return f.result;
			}
			_ => {
				System.error("internal error", "WasmRuntime.invokeCode: unsupported code tier");
				return Result.Uncomputed;
			}
		}
	}

	def getResult() -> int => result;
	def setResult(i: int) -> void => void(result = i);

	def createFunc0(funchole: int) => createFuncN(funchole, []);
	def createFunc1(funchole: int, o0: int) => createFuncN(funchole, [o0]);
	def createFunc2(funchole: int, o0: int, o1: int) => createFuncN(funchole, [o0, o1]);
	def createFunc3(funchole: int, o0: int, o1: int, o2: int) => createFuncN(funchole, [o0, o1, o2]);
	def createFunc4(funchole: int, o0: int, o1: int, o2: int, o3: int) => createFuncN(funchole, [o0, o1, o2, o3]);
	def createFunc5(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int) => createFuncN(funchole, [o0, o1, o2, o3, o4]);
	def createFunc6(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) => createFuncN(funchole, [o0, o1, o2, o3, o4, o5]);
	def createFunc7(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) => createFuncN(funchole, [o0, o1, o2, o3, o4, o5, o6]);
	def createFunc8(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) => createFuncN(funchole, [o0, o1, o2, o3, o4, o5, o6, o7]);
	def createFunc9(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) => createFuncN(funchole, [o0, o1, o2, o3, o4, o5, o6, o7, o8]);
	def createFuncRest(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0;
		args[1] = o1;
		args[2] = o2;
		args[3] = o3;
		args[4] = o4;
		args[5] = o5;
		args[6] = o6;
		args[7] = o7;
		args[8] = o8;
		popRestReverse(args, numRest);
		return createFuncN(funchole, args);
	}

	def createFuncRestRev(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0; args[1] = o1; args[2] = o2; args[3] = o3; args[4] = o4;
		args[5] = o5; args[6] = o6; args[7] = o7; args[8] = o8;
		popRestForward(args, numRest);
		return createFuncN(funchole, args);
	}

	def createFuncN(funcholeIdx: int, nonlocalArgs: Array<int>) -> int {
		def funchole = funcholes[funcholeIdx];
		def nonlocals: Array<(string, Object)> = Array.new(funchole.nonlocals.length);

		var j = 0;
		def fn = FuncObjects.newFO(funchole.id, funchole.params, nonlocals, funchole.body, funchole.metadata);
		for (i < funchole.nonlocals.length) {
			// if the nonlocal is the function itself (for recursion)
			if (Strings.equal(funchole.nonlocals[i], funchole.id)) {
				nonlocals[i] = (funchole.id, fn);
			} else {
				def nlIdx = nonlocalArgs[j++];
				nonlocals[i] = (funchole.nonlocals[i], objects[nlIdx]);
				decref(nlIdx);
			}
		}

		return alloc(fn);
	}

	def getField(objIdx: int, strIdx: int) -> int {
		def obj = objects[objIdx];
		def str = strings[strIdx];
		def field = obj.getField(str);
		decref(objIdx);
		return alloc(field);
	}
	def setField(objIdx: int, strIdx: int, valIdx: int) -> int {
		def obj = objects[objIdx];
		def str = strings[strIdx];
		def val = objects[valIdx];
		def r = if(obj.setField(str, val), valIdx, alloc(null));
		decref(objIdx); // valIdx is a passthrough (returned unchanged on success), not decref'd here
		return r;
	}
	def createClass(superIdx: int, classholeIdx: int) -> bool { /* returns if exception */
		def o = objects[superIdx];
		def classhole = classholes[classholeIdx];

		if (!o.instanceOf(ClassObjects.classClass)) {
			def exn = ExnObjects.fromWasm(Exceptions.typeMismatch(ClassObjects.classClass, o));
			decref(superIdx);
			result = alloc(exn);
			return true;
		}

		def superclass = ClassObject.!(o);
		decref(superIdx);
		result = alloc(classhole(superclass));
		return false;
	}
	// Shared class-walk/field-init/init-call core for createObject/
	// createObjectPtr; returns (isExn, resultObj) - callers convert
	// resultObj via alloc/objToPtr and assign `result` themselves.
	def createObjectFromClass(clsObj: ClassObject) -> (bool, Object) {
		def obj = Objects.newObject(clsObj);

		def classes: Vector<ClassObject> = Vector.new();
		for (cls = clsObj; cls != null; cls = cls.superclass)
			classes.put(cls);

		// initialization order is from base class downwards, which
		// may involve reinitializing some fields
		for (cls in classes.reverse().extract()) {
			if (cls.init != null) {
				def args: Array<(string, Object)> = [("self", obj)];
				match (invokeCode(cls.init.code, args, [])) {
					OK => ;
					Exn(e) => return (true, e);
					_ => System.error("internal error", "class init returned uncomputed");
				}
			}
		}
		return (false, obj);
	}
	def createObject(clsIdx: int) -> bool { /* returns if exception */
		def clsObj = ClassObject.!(objects[clsIdx]); // already asserted previously
		decref(clsIdx);
		def r = createObjectFromClass(clsObj);
		result = alloc(r.1);
		return r.0;
	}

	/* lists */
	def createListN(elems: Array<int>) -> int {
		def r = alloc(ListObjects.fromArray(Arrays.map(elems, objects.[])));
		for (e in elems) decref(e);
		return r;
	}
	def createList0()  => createListN([]);
	def createList1(o0: int) => createListN([o0]);
	def createList2(o0: int, o1: int) => createListN([o0, o1]);
	def createList3(o0: int, o1: int, o2: int) => createListN([o0, o1, o2]);
	def createList4(o0: int, o1: int, o2: int, o3: int) => createListN([o0, o1, o2, o3]);
	def createList5(o0: int, o1: int, o2: int, o3: int, o4: int) => createListN([o0, o1, o2, o3, o4]);
	def createList6(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) => createListN([o0, o1, o2, o3, o4, o5]);
	def createList7(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) => createListN([o0, o1, o2, o3, o4, o5, o6]);
	def createList8(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) => createListN([o0, o1, o2, o3, o4, o5, o6, o7]);
	def createList9(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) => createListN([o0, o1, o2, o3, o4, o5, o6, o7, o8]);
	def createListRest(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0;
		args[1] = o1;
		args[2] = o2;
		args[3] = o3;
		args[4] = o4;
		args[5] = o5;
		args[6] = o6;
		args[7] = o7;
		args[8] = o8;
		popRestReverse(args, numRest);
		return createListN(args);
	}

	def createListRestRev(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def args = Array<int>.new(9 + numRest);
		args[0] = o0; args[1] = o1; args[2] = o2; args[3] = o3; args[4] = o4;
		args[5] = o5; args[6] = o6; args[7] = o7; args[8] = o8;
		popRestForward(args, numRest);
		return createListN(args);
	}

	/* ====================================================================
	 * Shadow-stack mode (CiceroOptions.useShadowStack): raw Virgil object
	 * pointers instead of WasmRuntime.objects indices. No refcounting -
	 * liveness is handled by WasmShadowStackCompiler saving/restoring
	 * live pointers into the shadow stack around any call in this section.
	 * ==================================================================== */

	// Scratch memory for the int -> Object reinterpret cast below. A raw int
	// parameter has no addressable backing (Pointer.atField needs an actual
	// field/array-element reference), so it must be written into real memory
	// before it can be reinterpreted as a reference. Safe under reentrancy:
	// each call writes and immediately reads before returning, never spanning
	// another call.
	var ptrScratch: Array<int> = Array<int>.new(1);

	def objToPtr(obj: Object) -> int {
		if (obj == null) return 0;
		return int.view(Pointer.atObject(obj) - Pointer.NULL);
	}
	def ptrToObj(ptr: int) -> Object {
		if (ptr == 0) return null;
		ptrScratch[0] = ptr;
		return Pointer.atContents(ptrScratch).load<Object>();
	}

	// LOAD_CONST can't bake a raw pointer directly into the Wasm bytecode as an
	// i32.const immediate - Wasm code is immutable, so a relocating collection
	// would leave it stale with no way to fix it up. constsPtr (an ordinary,
	// already-Virgil-traced Array<Object> owned by this frame's WasmBytecode) is
	// the same kind of stable indirection as the index-mode objects[] vector;
	// this just does the equivalent lookup-by-index, freshly, on every access.
	def getConstPtr(idx: int) -> int {
		return objToPtr(constsPtr[idx]);
	}

	// Reserves {numSlots} shadow-stack slots and returns the frame's base
	// address (as a raw int, like everything else here). Mirrors
	// ShadowStackSpiller's alloc: read SHADOW_STACK_CUR_PTR, bump it by
	// numSlots*addressSize, return the old value.
	def shadowStackAlloc(numSlots: int) -> int {
		def base = CiRuntime.SHADOW_STACK_CUR_PTR.load<Pointer>();
		CiRuntime.SHADOW_STACK_CUR_PTR.store<Pointer>(base + numSlots * int.view(Pointer.SIZE));
		return int.view(base - Pointer.NULL);
	}
	// Pops the frame by restoring SHADOW_STACK_CUR_PTR to {base}.
	def shadowStackFree(base: int) {
		CiRuntime.SHADOW_STACK_CUR_PTR.store<Pointer>(Pointer.NULL + base);
	}
	def shadowStackSave(base: int, slot: int, ptr: int) {
		(Pointer.NULL + base + slot * int.view(Pointer.SIZE)).store<Pointer>(Pointer.NULL + ptr);
	}
	// Reloads a saved slot - must be re-read (not assumed unchanged) after any
	// call that could have triggered a relocating collection.
	def shadowStackLoad(base: int, slot: int) -> int {
		def p = (Pointer.NULL + base + slot * int.view(Pointer.SIZE)).load<Pointer>();
		return int.view(p - Pointer.NULL);
	}

	// XXX temporary, spike-only: lets JIT-compiled test code force a
	// (relocating) collection, to validate the construct-boundary shadow
	// protocol against a real GC. Remove once that's confirmed.
	def forceGCForTest() {
		RiGc.forceGC();
		RiGc.forceGC();
	}

	// Predicates. isNullPtr/isNotNullPtr are pure int comparisons - callable
	// directly as host functions for consistency with the rest of this family,
	// but WasmShadowStackCompiler may inline them as a bare i32 compare instead.
	def isNullPtr(ptr: int)    -> bool => ptr == 0;
	def isNotNullPtr(ptr: int) -> bool => ptr != 0;
	def isTruePtr(ptr: int)    -> bool => ptrToObj(ptr).isTrue();
	def isFalsePtr(ptr: int)   -> bool => !ptrToObj(ptr).isTrue();
	def isFuncPtr(ptr: int)    -> bool => ptrToObj(ptr).instanceOf(ClassObjects.classFunc);
	def isClassPtr(ptr: int)   -> bool => ptrToObj(ptr).instanceOf(ClassObjects.classClass);
	def isStringPtr(ptr: int)  -> bool => ptrToObj(ptr).instanceOf(ClassObjects.classStr);

	def getGlobalPtr(idx: int) -> int {
		def id = strings[idx];
		def obj = frame.getGlobal(id);
		return objToPtr(obj);
	}
	def getGlobalByIndexPtr(idx: int) -> int {
		return objToPtr(Globals.loadGlobalByIndex(idx));
	}
	def getNonlocalPtr(idx: int) -> int {
		def id = strings[idx];
		def obj = frame.getNonlocal(id);
		return objToPtr(obj);
	}
	def setGlobalPtr(strIdx: int, ptr: int) -> int {
		def obj = ptrToObj(ptr);
		def id = strings[strIdx];
		frame.setGlobal(id, obj);
		return ptr;
	}
	def setGlobalByIndexPtr(idx: int, ptr: int) -> int {
		Globals.storeGlobalByIndex(idx, ptrToObj(ptr));
		return ptr;
	}

	def raiseTypeExceptionPtr(actPtr: int, expPtr: int) -> int {
		def act = ptrToObj(actPtr);
		def exp = ptrToObj(expPtr);
		def msg = Exceptions.typeMismatch(ClassObject.!(exp), act);
		def exn = ExnObjects.fromWasm(msg);
		return objToPtr(exn);
	}
	def raiseStringPtr(strPtr: int) -> int {
		def str = ptrToObj(strPtr);
		def exn = ExnObjects.fromWasm(StrObject.!(str).str);
		return objToPtr(exn);
	}
	def raiseMissingFieldPtr(objPtr: int, strIdx: int) -> int {
		def obj = ptrToObj(objPtr);
		def str = strings[strIdx];
		def msg = Exceptions.missingField(obj, str);
		def exn = ExnObjects.fromWasm(msg);
		return objToPtr(exn);
	}

	// Each wrapper converts every raw pointer param to a real Object via
	// ptrToObj *before* building any array literal - array construction
	// itself allocates, and a raw pointer sitting in a plain `int` param is
	// invisible to Virgil's own GC (unlike a converted Object reference,
	// which Virgil's compiler-generated shadow-stack spilling protects
	// automatically once it's an ordinary typed local). Building the array
	// straight from the raw ints (as this used to do) left every argument
	// after the first unprotected across that allocation - if it triggered a
	// collection, a later ptrToObj(args[i]) call would dereference a stale,
	// possibly-moved address.
	def callFunc0Ptr(func: int) => callFuncNObjs(ptrToObj(func), []);
	def callFunc1Ptr(func: int, o0: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0);
		return callFuncNObjs(f, [a0]);
	}
	def callFunc2Ptr(func: int, o0: int, o1: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1);
		return callFuncNObjs(f, [a0, a1]);
	}
	def callFunc3Ptr(func: int, o0: int, o1: int, o2: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2);
		return callFuncNObjs(f, [a0, a1, a2]);
	}
	def callFunc4Ptr(func: int, o0: int, o1: int, o2: int, o3: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3);
		return callFuncNObjs(f, [a0, a1, a2, a3]);
	}
	def callFunc5Ptr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4);
		return callFuncNObjs(f, [a0, a1, a2, a3, a4]);
	}
	def callFunc6Ptr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5);
		return callFuncNObjs(f, [a0, a1, a2, a3, a4, a5]);
	}
	def callFunc7Ptr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6);
		return callFuncNObjs(f, [a0, a1, a2, a3, a4, a5, a6]);
	}
	def callFunc8Ptr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7);
		return callFuncNObjs(f, [a0, a1, a2, a3, a4, a5, a6, a7]);
	}
	def callFunc9Ptr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		return callFuncNObjs(f, [a0, a1, a2, a3, a4, a5, a6, a7, a8]);
	}
	// Same reasoning as callFunc0Ptr..9Ptr: convert every raw pointer to a
	// real Object first, then build the args array from already-safe
	// references (and drain the rest from xargsObjs, not xargs - see its
	// own doc comment).
	def callFuncRestPtr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestReverseObjs(args, numRest);
		return callFuncNObjs(f, args);
	}
	def callFuncRestRevPtr(func: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> bool {
		def f = ptrToObj(func); def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestForwardObjs(args, numRest);
		return callFuncNObjs(f, args);
	}
	// Takes already-converted Objects - used by the callFunc0Ptr..9Ptr
	// wrappers above, which convert every raw pointer arg before this ever
	// runs, so nothing here needs (or gets) a fresh ptrToObj call on a
	// possibly-stale int.
	def callFuncNObjs(fnObj: Object, args: Array<Object>) -> bool { /* returns if exception */
		def fv = FuncObject.!(fnObj);
		def params = fv.params, code = fv.code;

		var argv: Array<(string, Object)>;
		if (fv.instanceOf(ClassObjects.classMethod)) {
			argv = Array.new(args.length + 1);
			for (i < args.length) {
				if (i < params.length) argv[i + 1] = (params[i], args[i]);
			}
			argv[0] = ("self", MethodObject.!(fv).obj);
		} else {
			argv = Array.new(args.length);
			for (i < args.length) {
				if (i < params.length) argv[i] = (params[i], args[i]);
			}
		}

		if (args.length != params.length) {
			def obj = ExnObjects.fromWasm(Exceptions.arityMismatch(params.length, args.length));
			result = objToPtr(obj);
			return true;
		}

		match (invokeCode(code, argv, fv.nonlocals)) {
			OK(v) => { result = objToPtr(v); return false; }
			Exn(e) => { result = objToPtr(e); return true; }
			_ => { System.error("internal error", "evaluation of frame returned uncomputed"); return false; }
		}
	}

	// Same reasoning as callFunc0Ptr..9Ptr above: convert every raw pointer
	// nonlocal-capture arg to a real Object before building any array.
	// {funchole} itself is a compile-time pool index, not a pointer - safe
	// as a plain int throughout.
	def createFunc0Ptr(funchole: int) => createFuncNObjs(funchole, []);
	def createFunc1Ptr(funchole: int, o0: int) -> int {
		def a0 = ptrToObj(o0);
		return createFuncNObjs(funchole, [a0]);
	}
	def createFunc2Ptr(funchole: int, o0: int, o1: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1);
		return createFuncNObjs(funchole, [a0, a1]);
	}
	def createFunc3Ptr(funchole: int, o0: int, o1: int, o2: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2);
		return createFuncNObjs(funchole, [a0, a1, a2]);
	}
	def createFunc4Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3);
		return createFuncNObjs(funchole, [a0, a1, a2, a3]);
	}
	def createFunc5Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4);
		return createFuncNObjs(funchole, [a0, a1, a2, a3, a4]);
	}
	def createFunc6Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5);
		return createFuncNObjs(funchole, [a0, a1, a2, a3, a4, a5]);
	}
	def createFunc7Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6);
		return createFuncNObjs(funchole, [a0, a1, a2, a3, a4, a5, a6]);
	}
	def createFunc8Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7);
		return createFuncNObjs(funchole, [a0, a1, a2, a3, a4, a5, a6, a7]);
	}
	def createFunc9Ptr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		return createFuncNObjs(funchole, [a0, a1, a2, a3, a4, a5, a6, a7, a8]);
	}
	def createFuncRestPtr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestReverseObjs(args, numRest);
		return createFuncNObjs(funchole, args);
	}
	def createFuncRestRevPtr(funchole: int, o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestForwardObjs(args, numRest);
		return createFuncNObjs(funchole, args);
	}
	// Takes already-converted Objects - used by createFunc0Ptr..9Ptr above,
	// which convert every raw pointer arg first.
	def createFuncNObjs(funcholeIdx: int, nonlocalArgs: Array<Object>) -> int {
		def funchole = funcholes[funcholeIdx];
		def nonlocals: Array<(string, Object)> = Array.new(funchole.nonlocals.length);

		var j = 0;
		def fn = FuncObjects.newFO(funchole.id, funchole.params, nonlocals, funchole.body, funchole.metadata);
		for (i < funchole.nonlocals.length) {
			if (Strings.equal(funchole.nonlocals[i], funchole.id)) {
				nonlocals[i] = (funchole.id, fn);
			} else {
				nonlocals[i] = (funchole.nonlocals[i], nonlocalArgs[j++]);
			}
		}

		return objToPtr(fn);
	}

	def getFieldPtr(objPtr: int, strIdx: int) -> int {
		def obj = ptrToObj(objPtr);
		def str = strings[strIdx];
		def field = obj.getField(str);
		return objToPtr(field);
	}
	def setFieldPtr(objPtr: int, strIdx: int, valPtr: int) -> int {
		def obj = ptrToObj(objPtr);
		def str = strings[strIdx];
		def val = ptrToObj(valPtr);
		return if(obj.setField(str, val), valPtr, 0);
	}

	def createClassPtr(superPtr: int, classholeIdx: int) -> bool { /* returns if exception */
		def o = ptrToObj(superPtr);
		def classhole = classholes[classholeIdx];

		if (!o.instanceOf(ClassObjects.classClass)) {
			def exn = ExnObjects.fromWasm(Exceptions.typeMismatch(ClassObjects.classClass, o));
			result = objToPtr(exn);
			return true;
		}

		def superclass = ClassObject.!(o);
		result = objToPtr(classhole(superclass));
		return false;
	}
	def createObjectPtr(clsPtr: int) -> bool { /* returns if exception */
		def clsObj = ClassObject.!(ptrToObj(clsPtr)); // already asserted previously
		def r = createObjectFromClass(clsObj);
		result = objToPtr(r.1);
		return r.0;
	}

	// Same reasoning as callFunc0Ptr..9Ptr above: convert every raw pointer
	// element to a real Object before building any array.
	def createListNObjs(elems: Array<Object>) -> int => objToPtr(ListObjects.fromArray(elems));
	def createList0Ptr()  => createListNObjs([]);
	def createList1Ptr(o0: int) -> int {
		def a0 = ptrToObj(o0);
		return createListNObjs([a0]);
	}
	def createList2Ptr(o0: int, o1: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1);
		return createListNObjs([a0, a1]);
	}
	def createList3Ptr(o0: int, o1: int, o2: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2);
		return createListNObjs([a0, a1, a2]);
	}
	def createList4Ptr(o0: int, o1: int, o2: int, o3: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3);
		return createListNObjs([a0, a1, a2, a3]);
	}
	def createList5Ptr(o0: int, o1: int, o2: int, o3: int, o4: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4);
		return createListNObjs([a0, a1, a2, a3, a4]);
	}
	def createList6Ptr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5);
		return createListNObjs([a0, a1, a2, a3, a4, a5]);
	}
	def createList7Ptr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6);
		return createListNObjs([a0, a1, a2, a3, a4, a5, a6]);
	}
	def createList8Ptr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7);
		return createListNObjs([a0, a1, a2, a3, a4, a5, a6, a7]);
	}
	def createList9Ptr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		return createListNObjs([a0, a1, a2, a3, a4, a5, a6, a7, a8]);
	}
	def createListRestPtr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestReverseObjs(args, numRest);
		return createListNObjs(args);
	}
	def createListRestRevPtr(o0: int, o1: int, o2: int, o3: int, o4: int, o5: int, o6: int, o7: int, o8: int, numRest: int) -> int {
		def a0 = ptrToObj(o0); def a1 = ptrToObj(o1); def a2 = ptrToObj(o2); def a3 = ptrToObj(o3); def a4 = ptrToObj(o4); def a5 = ptrToObj(o5); def a6 = ptrToObj(o6); def a7 = ptrToObj(o7); def a8 = ptrToObj(o8);
		def args = Array<Object>.new(9 + numRest);
		args[0] = a0; args[1] = a1; args[2] = a2; args[3] = a3; args[4] = a4;
		args[5] = a5; args[6] = a6; args[7] = a7; args[8] = a8;
		popRestForwardObjs(args, numRest);
		return createListNObjs(args);
	}

	def alloc(obj: Object) -> int {
		if (obj == null) return 0;

		if (CiceroOptions.useRefcounting && !freelist.empty()) {
			def idx = freelist.pop();
			if (CiceroOptions.sanityChecks && (idx < constPoolLen || objects[idx] != null))
				System.error("internal error", "WasmRuntime.alloc: corrupt freelist entry");
			objects[idx] = obj;
			refcounts[idx] = 1;
			return idx;
		}
		def idx = objects.length;
		objects.put(obj);
		refcounts.put(1);
		return idx;
	}
}


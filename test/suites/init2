(set GLOBAL_X "GLOBAL_X")
(class BasicClass
    (field x 1)
    (field y 9)
    (init {
        (set-field x self (+ self.x 10))
        (set-field y self (+ self.y 10))
    })
)

(class TargetRoot
    ; Should run first
    (field trace 1) ; Desugars to: (set-field trace self 1)
    (field name "TargetRoot")
)

(class TargetParent
    (extends TargetRoot)
    ; Should run second
    (init {
        (set-field trace self (+ self.trace 10))
        (set-field name self (+ self.name " TargetParent"))
    })
)

(class TargetChild
    (extends TargetParent)
    ; Should run third.
    (field trace (+ self.trace 100))
    (init {
        (set-field name self (+ self.name " TargetChild"))
    })
)

(class DependencyBase
    (field x 5)
    (field y (+ self.x 5)) ; self.x should be set first (y should be 10)
)

(class DependencyChild
    (extends DependencyBase)
    (field z (+ self.y 10)) ; superclass field self.y should be set before this executes (z should be 20)
)

(class GhostMiddle
    (extends DependencyChild)
)

(class GhostMiddleExtended
    (extends GhostMiddle)
    (field gx GLOBAL_X)
    (init {
        (set-field z self (+ self.z 9)) ; self.z should be 29
    })
)

